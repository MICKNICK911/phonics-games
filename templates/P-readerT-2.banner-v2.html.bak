<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <title>Decodable Reader</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <style>
    :root {
      --bg: #f1f5f9;
      --surface: #ffffff;
      --surface-2: #f8fafc;
      --border: #e2e8f0;
      --text: #0f172a;
      --text-2: #475569;
      --text-3: #94a3b8;
      --accent: #f59e0b;
      --accent-dark: #d97706;
      --primary: #2563eb;
      --success: #16a34a;
      --danger: #dc2626;
      --radius: 16px;
      --radius-sm: 10px;
      --shadow: 0 4px 20px rgba(15,23,42,0.08);
      --day1: #ef4444;
      --day2: #eab308;
      --day3: #22c55e;
      --day4: #3b82f6;
      --day5: #a855f7;
    }
    [data-theme="dark"] {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-2: #334155;
      --border: #334155;
      --text: #f8fafc;
      --text-2: #cbd5e1;
      --text-3: #64748b;
      --shadow: 0 4px 20px rgba(0,0,0,0.4);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100%;
      -webkit-font-smoothing: antialiased;
      line-height: 1.5;
    }
    body { padding: 0; overflow-x: hidden; }

    /* Icon defaults */
    svg { display: inline-block; flex-shrink: 0; }
    .icon-btn > svg { width: 20px; height: 20px; }
    .btn > svg { width: 18px; height: 18px; }
    .btn-lg > svg { width: 20px; height: 20px; }
    .icon-inline { width: 13px; height: 13px; vertical-align: -2px; margin-right: 2px; }
    .badge-icon  { width: 11px; height: 11px; vertical-align: -1px; margin-right: 2px; }
    .banner-icon { width: 16px; height: 16px; vertical-align: -3px; margin-right: 4px; }
    .app-header h1 > svg { width: 20px; height: 20px; vertical-align: -4px; margin-right: 4px; }
    .profile-card .logo svg { width: 56px; height: 56px; color: var(--accent); }

    /* Screens */
    .screen { display: none; min-height: 100vh; flex-direction: column; }
    .screen.active { display: flex; }

    /* Header */
    .app-header {
      position: sticky; top: 0; z-index: 50;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 12px 16px;
      display: flex; align-items: center; gap: 10px;
      box-shadow: 0 1px 0 var(--border);
    }
    .app-header h1 { font-size: 1.05rem; font-weight: 800; flex: 1; letter-spacing: -0.02em; }
    .app-header .meta { font-size: 0.72rem; color: var(--text-3); font-weight: 600; }
    .icon-btn {
      width: 40px; height: 40px; border-radius: 50%;
      border: 1px solid var(--border); background: var(--surface-2);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; color: var(--text);
      flex-shrink: 0;
    }
    .icon-btn:active { transform: scale(0.94); }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 22px; border: none; border-radius: 12px;
      font-family: inherit; font-size: 0.95rem; font-weight: 700;
      cursor: pointer; transition: transform 0.12s, opacity 0.12s;
      letter-spacing: -0.01em;
    }
    .btn:active:not(:disabled) { transform: scale(0.97); }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-primary { background: var(--accent); color: #0f172a; }
    .btn-primary:not(:disabled):hover { background: var(--accent-dark); }
    .btn-success { background: var(--success); color: #fff; }
    .btn-wa { background: linear-gradient(135deg, #25d366, #128c7e); color: #fff; }
    .btn-outline {
      background: transparent; border: 2px solid var(--border); color: var(--text-2);
    }
    .btn-block { width: 100%; }
    .btn-lg { padding: 16px 24px; font-size: 1.05rem; border-radius: 14px; }

    /* Profile Screen */
    #profileScreen {
      justify-content: center; padding: 24px 20px;
      background: radial-gradient(ellipse at top, #fef3c7 0%, transparent 55%), var(--bg);
    }
    [data-theme="dark"] #profileScreen {
      background: radial-gradient(ellipse at top, #1e293b 0%, transparent 55%), var(--bg);
    }
    .profile-card {
      background: var(--surface); border-radius: 24px; padding: 32px 24px;
      box-shadow: var(--shadow); border: 1px solid var(--border); max-width: 400px; width: 100%; margin: 0 auto;
    }
    .profile-card .logo { text-align: center; margin-bottom: 12px; line-height: 1; }
    .profile-card h2 { text-align: center; font-size: 1.4rem; font-weight: 800; margin-bottom: 4px; }
    .profile-card .sub { text-align: center; color: var(--text-2); font-size: 0.9rem; margin-bottom: 24px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 0.75rem; font-weight: 700; color: var(--text-2); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.04em; }
    .form-group input {
      width: 100%; padding: 14px 16px; border: 2px solid var(--border); border-radius: 12px;
      font-size: 1rem; font-family: inherit; background: var(--surface-2); color: var(--text);
    }
    .form-group input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px rgba(245,158,11,0.2); }
    .char-count { font-size: 0.7rem; color: var(--text-3); text-align: right; margin-top: 4px; }

    /* Home / Lesson List */
    #homeScreen .content { flex: 1; padding: 16px; overflow-y: auto; }
    .student-banner {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 14px 16px; margin-bottom: 12px; display: flex; align-items: center; gap: 12px;
    }
    .student-banner .avatar {
      width: 44px; height: 44px; border-radius: 50%; background: var(--accent);
      display: flex; align-items: center; justify-content: center; font-weight: 800; color: #0f172a; font-size: 1.1rem;
    }
    .student-banner .info { flex: 1; min-width: 0; }
    .student-banner .name { font-weight: 800; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .student-banner .grade { font-size: 0.78rem; color: var(--text-3); font-weight: 600; }

    /* Data bar (export / backup / import) */
    .data-bar {
      display: flex; gap: 8px; margin-bottom: 16px;
    }
    .data-btn {
      flex: 1; padding: 10px 8px; border-radius: 10px;
      border: 1px solid var(--border); background: var(--surface);
      color: var(--text-2); font-family: inherit; font-size: 0.72rem; font-weight: 700;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 5px;
      letter-spacing: -0.01em; line-height: 1;
      -webkit-tap-highlight-color: transparent;
    }
    .data-btn:active { transform: scale(0.97); }
    .data-btn:hover { border-color: var(--accent); color: var(--text); }
    .data-btn svg { width: 14px; height: 14px; flex-shrink: 0; }

    .lesson-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 16px; margin-bottom: 10px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s;
      display: flex; gap: 14px; align-items: flex-start;
    }
    .lesson-card:active { transform: scale(0.99); }
    .lesson-card:hover { border-color: var(--accent); box-shadow: var(--shadow); }
    .lesson-num {
      width: 42px; height: 42px; border-radius: 12px; background: var(--surface-2);
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 0.95rem; color: var(--text-2); flex-shrink: 0;
    }
    .lesson-card.mastered .lesson-num { background: var(--day5); color: #fff; }
    .lesson-body { flex: 1; min-width: 0; }
    .lesson-title { font-weight: 700; font-size: 0.95rem; margin-bottom: 2px; }
    .lesson-sound { font-size: 0.75rem; color: var(--text-3); font-weight: 600; margin-bottom: 8px; }
    .day-pills { display: flex; gap: 5px; flex-wrap: wrap; align-items: center; }
    .day-pill {
      width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.65rem; font-weight: 800; color: var(--text-3); background: var(--surface-2);
    }
    .day-pill.done { color: #fff; border-color: transparent; }
    .day-pill.d1 { background: var(--day1); }
    .day-pill.d2 { background: var(--day2); color: #0f172a; }
    .day-pill.d3 { background: var(--day3); }
    .day-pill.d4 { background: var(--day4); }
    .day-pill.d5 { background: var(--day5); }
    .day-label { font-size: 0.72rem; font-weight: 700; color: var(--text-2); margin-left: 4px; }
    .mastered-badge {
      display: inline-flex; align-items: center;
      background: linear-gradient(135deg, #a855f7, #6366f1);
      color: #fff; font-size: 0.65rem; font-weight: 800; padding: 3px 8px;
      border-radius: 20px; letter-spacing: 0.02em; margin-top: 6px;
    }

    /* Reading Screen */
    #readingScreen .content { flex: 1; padding: 16px; overflow-y: auto; padding-bottom: 100px; }
    .target-bar {
      background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
      padding: 10px 14px; margin-bottom: 14px; display: flex; align-items: center; gap: 10px;
    }
    .target-bar .sound { font-size: 0.85rem; font-weight: 700; color: var(--text-2); flex: 1; }
    .story-area { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px 16px; }
    .story-line {
      display: flex; flex-wrap: wrap; gap: 6px 8px; margin-bottom: 14px;
      padding-bottom: 14px; border-bottom: 1px dashed var(--border);
    }
    .story-line:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .story-line.dimmed { opacity: 0.45; }
    .story-line.hidden-chunk { display: none; }
    .word {
      display: inline-block; padding: 6px 4px; border-radius: 6px;
      font-size: 1.15rem; font-weight: 600; cursor: pointer; user-select: none;
      transition: color 0.15s, background 0.15s, transform 0.1s;
      -webkit-tap-highlight-color: transparent;
      color: var(--text);
    }
    .word:active { transform: scale(0.96); }
    .word.tapped { font-weight: 700; }
    .word.tapped.d1 { color: var(--day1); }
    .word.tapped.d2 { color: var(--day2); }
    .word.tapped.d3 { color: var(--day3); }
    .word.tapped.d4 { color: var(--day4); }
    .word.tapped.d5 { color: var(--day5); }
    .progress-row {
      display: flex; align-items: center; gap: 10px; margin-top: 14px;
      font-size: 0.8rem; font-weight: 600; color: var(--text-2);
    }
    .progress-track { flex: 1; height: 8px; background: var(--surface-2); border-radius: 20px; overflow: hidden; border: 1px solid var(--border); }
    .progress-fill { height: 100%; background: var(--accent); border-radius: 20px; transition: width 0.3s; width: 0%; }

    .bottom-bar {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 40;
      background: var(--surface); border-top: 1px solid var(--border);
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      display: flex; gap: 10px;
    }
    .bottom-bar .btn { flex: 1; }

    /* Questions */
    #questionsScreen .content { flex: 1; padding: 16px; overflow-y: auto; padding-bottom: 100px; }
    .q-progress {
      font-size: 0.8rem; font-weight: 700; color: var(--text-3);
      margin-bottom: 12px; letter-spacing: 0.04em;
    }
    .q-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 22px 18px; box-shadow: var(--shadow);
    }
    .q-text { font-size: 1.15rem; font-weight: 700; margin-bottom: 20px; line-height: 1.4; }
    .q-opt {
      display: block; width: 100%; text-align: left;
      padding: 16px 18px; margin-bottom: 10px; border-radius: 12px;
      border: 2px solid var(--border); background: var(--surface-2);
      font-family: inherit; font-size: 1rem; font-weight: 600; color: var(--text);
      cursor: pointer; transition: border-color 0.15s, background 0.15s;
    }
    .q-opt:active:not(:disabled) { transform: scale(0.98); }
    .q-opt:hover:not(:disabled) { border-color: var(--accent); }
    .q-opt.correct { border-color: var(--success); background: #dcfce7; color: #166534; }
    .q-opt.wrong { border-color: var(--danger); background: #fee2e2; color: #991b1b; }
    .q-opt:disabled { cursor: default; }
    [data-theme="dark"] .q-opt.correct { background: #14532d; color: #bbf7d0; }
    [data-theme="dark"] .q-opt.wrong { background: #7f1d1d; color: #fecaca; }
    .feedback-banner {
      margin-top: 14px; padding: 12px 16px; border-radius: 12px;
      font-weight: 700; text-align: center; display: none;
    }
    .feedback-banner.show { display: block; }
    .feedback-banner.ok { background: #dcfce7; color: #166534; }
    .feedback-banner.bad { background: #fee2e2; color: #991b1b; }
    [data-theme="dark"] .feedback-banner.ok { background: #14532d; color: #bbf7d0; }
    [data-theme="dark"] .feedback-banner.bad { background: #7f1d1d; color: #fecaca; }

    /* Sound Hunt */
    #soundHuntScreen .content { flex: 1; padding: 16px; overflow-y: auto; padding-bottom: 100px; }
    .sh-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 20px 16px; box-shadow: var(--shadow);
    }
    .sh-instruction {
      font-size: 1rem; font-weight: 700; margin-bottom: 6px; line-height: 1.4;
      text-align: center;
    }
    .sh-instruction .sh-sound {
      color: var(--accent-dark);
      background: #fef3c7;
      padding: 1px 8px;
      border-radius: 6px;
      white-space: nowrap;
    }
    [data-theme="dark"] .sh-instruction .sh-sound {
      background: #78350f;
      color: #fde68a;
    }
    .sh-counter {
      font-size: 0.85rem; font-weight: 700; color: var(--text-3);
      text-align: center; margin-bottom: 16px; letter-spacing: 0.04em;
    }
    .sh-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 14px;
    }
    .sh-tile {
      padding: 18px 10px;
      border-radius: 12px;
      border: 2px solid var(--border);
      background: var(--surface-2);
      font-family: inherit;
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s, transform 0.1s;
      text-align: center;
      min-height: 56px;
      word-break: break-word;
      -webkit-tap-highlight-color: transparent;
    }
    .sh-tile:hover:not(:disabled) { border-color: var(--accent); }
    .sh-tile:active:not(:disabled) { transform: scale(0.97); }
    .sh-tile.selected {
      border-color: var(--accent);
      background: #fef3c7;
      color: #92400e;
    }
    [data-theme="dark"] .sh-tile.selected {
      background: #78350f;
      color: #fde68a;
      border-color: var(--accent);
    }
    .sh-tile.wrong {
      border-color: var(--danger);
      background: #fee2e2;
      color: #991b1b;
      animation: sh-shake 0.35s;
    }
    [data-theme="dark"] .sh-tile.wrong {
      background: #7f1d1d;
      color: #fecaca;
    }
    .sh-tile:disabled { cursor: default; }
    @keyframes sh-shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }

    /* Results */
    #resultsScreen .content { flex: 1; padding: 16px; overflow-y: auto; padding-bottom: 24px; }
    .result-badge {
      background: var(--surface); border: 2px solid var(--border); border-radius: 20px;
      padding: 28px 20px; text-align: center; box-shadow: var(--shadow);
      max-width: 400px; margin: 0 auto;
    }
    .result-badge .badge-title {
      font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text-3); margin-bottom: 8px;
    }
    .result-badge .score-big {
      font-size: 3rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1;
      margin: 8px 0;
    }
    .result-badge .score-big.pass { color: var(--success); }
    .result-badge .score-big.fail { color: var(--danger); }
    .result-badge .day-announce {
      display: inline-block; padding: 6px 16px; border-radius: 20px;
      font-weight: 800; font-size: 0.9rem; color: #fff; margin: 10px 0;
    }
    .result-badge .details {
      text-align: left; margin-top: 18px; padding-top: 16px;
      border-top: 1px dashed var(--border); font-size: 0.88rem;
    }
    .result-badge .details .row {
      display: flex; justify-content: space-between; padding: 5px 0;
    }
    .result-badge .details .label { color: var(--text-3); font-weight: 600; }
    .result-badge .details .val { font-weight: 700; text-align: right; }
    .result-badge .day-row { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
    .result-badge .day-row .dp {
      width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 800; border: 2px solid var(--border); color: var(--text-3);
    }
    .result-badge .day-row .dp.done { color: #fff; border-color: transparent; }
    .result-badge .day-row .dp.done.d2 { color: #0f172a; }
    .result-badge .champ {
      margin-top: 14px; padding: 10px 14px; border-radius: 12px;
      background: linear-gradient(135deg, #a855f7, #6366f1); color: #fff;
      font-weight: 800; font-size: 0.9rem; display: none;
      align-items: center; justify-content: center;
    }
    .result-badge .champ svg { width: 16px; height: 16px; margin-right: 6px; }
    .result-badge .champ.show { display: inline-flex; }
    .finish-code-box {
      margin: 14px auto 0;
      padding: 12px 16px;
      background: var(--surface-2);
      border: 2px dashed var(--primary);
      border-radius: 14px;
      text-align: center;
      max-width: 320px;
      cursor: pointer;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      transition: background 0.15s ease;
    }
    .finish-code-box:hover { background: var(--surface); }
    .finish-code-label {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-3);
      margin-bottom: 4px;
    }
    .finish-code-value {
      font-family: ui-monospace, Menlo, Consolas, 'Courier New', monospace;
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: var(--primary);
      line-height: 1.1;
      word-break: break-all;
    }
    .finish-code-meta {
      font-size: 0.72rem;
      color: var(--text-3);
      margin-top: 4px;
      font-weight: 600;
    }
    .result-actions { max-width: 400px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
    .submit-note { font-size: 0.75rem; color: var(--text-3); text-align: center; margin-top: 4px; }

    /* Segment mode */
    #readingScreen.segment-mode {
      background: linear-gradient(180deg, #ede9fe 0%, var(--bg) 40%);
    }
    [data-theme="dark"] #readingScreen.segment-mode {
      background: linear-gradient(180deg, #2e1065 0%, var(--bg) 45%);
    }
    #readingScreen.segment-mode .story-area {
      border-color: #a78bfa;
      box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.25);
    }
    #readingScreen.segment-mode .word {
      outline: 1.5px dashed transparent;
    }
    #readingScreen.segment-mode .word:active {
      outline-color: #a78bfa;
    }
    .segment-banner {
      display: none;
      align-items: center; justify-content: space-between; gap: 10px;
      background: linear-gradient(135deg, #7c3aed, #6366f1);
      color: #fff; padding: 10px 14px; border-radius: 12px; margin-bottom: 12px;
      font-size: 0.85rem; font-weight: 700;
    }
    #readingScreen.segment-mode .segment-banner { display: flex; }
    .segment-banner .seg-label { display: inline-flex; align-items: center; }
    .segment-banner .seg-label svg { width: 16px; height: 16px; margin-right: 6px; }
    .segment-banner .exit-seg {
      background: rgba(255,255,255,0.2); border: none; color: #fff;
      padding: 6px 12px; border-radius: 8px; font-weight: 700; font-size: 0.78rem;
      font-family: inherit; cursor: pointer;
    }

    /* Segment overlay / modal */
    .segment-overlay {
      position: fixed; inset: 0; z-index: 100; background: rgba(15,23,42,0.92);
      display: none; align-items: center; justify-content: center; padding: 24px;
    }
    .segment-overlay.show { display: flex; }
    .segment-inner {
      text-align: center; max-width: 96vw;
      background: #1e293b; border-radius: 20px; padding: 28px 20px 24px;
      border: 1px solid #334155; box-shadow: 0 20px 50px rgba(0,0,0,0.4);
    }
    .segment-word {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 4px;
      font-size: clamp(36px, 10vw, 80px); font-weight: 800; color: #fff; line-height: 1.15;
      margin-bottom: 20px;
    }
    .segment-letter {
      display: inline-flex; padding: 4px 6px; border-radius: 8px; cursor: pointer;
      transition: transform 0.12s, color 0.15s; user-select: none;
    }
    .segment-letter:active { transform: scale(0.95); }
    .segment-actions {
      display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 12px;
    }
    .segment-actions .btn { min-width: 140px; }
    .segment-hint { color: #94a3b8; font-size: 0.8rem; font-weight: 600; }

    /* Toast */
    .toast {
      position: fixed; left: 50%; bottom: 90px; transform: translateX(-50%) translateY(40px);
      background: #0f172a; color: #fff; padding: 12px 20px; border-radius: 24px;
      font-size: 0.85rem; font-weight: 600; opacity: 0; transition: all 0.3s; z-index: 200;
      max-width: 90vw; text-align: center; pointer-events: none;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* Locked button state */
    .btn-locked {
      background: var(--surface-2) !important; color: var(--text-3) !important;
      border: 2px solid var(--border) !important;
    }

    /* ===== App-bar day chip ===== */
    .day-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 7px 12px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 800;
      color: #fff;
      letter-spacing: 0.02em;
      line-height: 1;
      white-space: nowrap;
      flex-shrink: 0;
    }
    /* Target-bar context (Sound Hunt screen) keeps the smaller variant */
    .target-bar .day-chip {
      padding: 4px 10px;
      font-size: 0.7rem;
    }

    /* ===== Overflow menu (reading app bar) ===== */
    .menu-wrap {
      position: relative;
      flex-shrink: 0;
    }
    .overflow-menu {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(15,23,42,0.15);
      min-width: 220px;
      padding: 6px;
      z-index: 100;
      display: none;
    }
    [data-theme="dark"] .overflow-menu {
      box-shadow: 0 8px 30px rgba(0,0,0,0.5);
    }
    .overflow-menu.open {
      display: block;
      animation: menuFade 0.15s ease-out;
    }
    @keyframes menuFade {
      from { opacity: 0; transform: translateY(-4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .menu-item {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 11px 12px;
      border: none;
      background: transparent;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
      text-align: left;
      letter-spacing: -0.01em;
      -webkit-tap-highlight-color: transparent;
    }
    .menu-item:hover  { background: var(--surface-2); }
    .menu-item:active { background: var(--border); }
    .menu-item .menu-icon {
      width: 18px; height: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--text-2);
      flex-shrink: 0;
    }
    .menu-item .menu-icon svg { width: 18px; height: 18px; }
    .menu-item .menu-label { flex: 1; }
    .menu-item .menu-check {
      color: #7c3aed;
      font-weight: 900;
      font-size: 0.95rem;
      display: none;
    }
    .menu-item.active-seg {
      background: #ede9fe;
      color: #6d28d9;
    }
    .menu-item.active-seg .menu-icon { color: #7c3aed; }
    .menu-item.active-seg .menu-check { display: inline-flex; }
    [data-theme="dark"] .menu-item.active-seg { background: #2e1065; color: #c4b5fd; }
    [data-theme="dark"] .menu-item.active-seg .menu-icon { color: #a78bfa; }
    .menu-item.is-slow .menu-icon { color: #d97706; }
    [data-theme="dark"] .menu-item.is-slow .menu-icon { color: #fbbf24; }
    .menu-divider {
      height: 1px;
      background: var(--border);
      margin: 4px 6px;
    }

    /* Wrong-answer modal */
    .wrong-modal-overlay {
      position: fixed; inset: 0; z-index: 150;
      background: rgba(15,23,42,0.55);
      display: none; align-items: center; justify-content: center; padding: 24px;
      opacity: 0; transition: opacity 0.15s ease;
    }
    .wrong-modal-overlay.show { display: flex; opacity: 1; }
    .wrong-modal {
      background: #fef2f2; border: 2px solid #fca5a5;
      border-radius: 20px; padding: 28px 22px;
      max-width: 360px; width: 100%; text-align: center;
      box-shadow: 0 20px 50px rgba(0,0,0,0.35);
      transform: scale(0.95); transition: transform 0.15s ease;
    }
    .wrong-modal-overlay.show .wrong-modal { transform: scale(1); }
    [data-theme="dark"] .wrong-modal { background: #450a0a; border-color: #7f1d1d; }
    .wrong-modal-icon { font-size: 2.5rem; font-weight: 800; line-height: 1; color: #dc2626; margin-bottom: 10px; }
    [data-theme="dark"] .wrong-modal-icon { color: #fca5a5; }
    .wrong-modal-title { font-size: 1.2rem; font-weight: 800; margin-bottom: 6px; color: #991b1b; }
    [data-theme="dark"] .wrong-modal-title { color: #fecaca; }
    .wrong-modal-body { font-size: 0.9rem; color: #7f1d1d; margin-bottom: 20px; font-weight: 600; }
    [data-theme="dark"] .wrong-modal-body { color: #fecaca; }
    .btn-danger { background: #dc2626; color: #fff; }
    .btn-danger:hover:not(:disabled) { background: #b91c1c; }

    .res-subtitle {
      font-size: 0.72rem; font-weight: 800; letter-spacing: 0.06em;
      text-transform: uppercase; margin-bottom: 12px;
    }
    .res-subtitle.pass { color: var(--success); }
    .res-subtitle.fail { color: var(--danger); }
    .res-meta {
      text-align: left; margin-top: 12px; padding-top: 12px;
      border-top: 1px dashed var(--border);
    }
    .res-meta-line {
      font-size: 0.85rem; font-weight: 600; padding: 2px 0; line-height: 1.35;
    }
    .res-meta-line.muted { color: var(--text-3); font-weight: 500; font-size: 0.8rem; }
    .results-bottom-bar { flex-direction: column; gap: 8px; }
    .results-secondary-row { display: flex; gap: 8px; width: 100%; }
    .results-secondary-row .btn { flex: 1; padding: 12px 16px; font-size: 0.9rem; }    

    /* ===== Reading video (opt-in) ===== */
    .rec-pill {
      position: fixed; top: 70px; right: 12px; z-index: 60;
      background: #dc2626; color: #fff; font-size: 0.7rem; font-weight: 800;
      padding: 4px 10px; border-radius: 20px; letter-spacing: 0.04em;
      -webkit-animation: recBlink 1.4s infinite; animation: recBlink 1.4s infinite;
      pointer-events: auto;
    }
    @-webkit-keyframes recBlink { 0%,100% { opacity: 1; } 50% { opacity: 0.45; } }
    @keyframes recBlink { 0%,100% { opacity: 1; } 50% { opacity: 0.45; } }
    .rec-overlay {
      position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 120;
      background: rgba(15,23,42,0.75); display: none; padding: 16px;
      overflow-y: auto; -webkit-overflow-scrolling: touch;
    }
    .rec-overlay.show { display: block; }
    .rec-sheet {
      background: #ffffff; background: var(--surface);
      color: #0f172a; color: var(--text);
      border-radius: 18px; max-width: 480px; margin: 0 auto; padding: 18px 16px 20px;
    }
    .rec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
    .rec-head h3 { font-size: 1.05rem; font-weight: 800; }
    .rec-note { font-size: 0.78rem; color: #475569; color: var(--text-2); margin-bottom: 12px; line-height: 1.4; }
    .rec-empty { font-size: 0.88rem; color: #94a3b8; color: var(--text-3); text-align: center; padding: 22px 8px; }
    .rec-item {
      border: 1px solid #e2e8f0; border: 1px solid var(--border);
      border-radius: 12px; padding: 12px; margin-bottom: 10px;
      background: #f8fafc; background: var(--surface-2);
    }
    .rec-title { font-weight: 700; font-size: 0.9rem; }
    .rec-meta { font-size: 0.74rem; color: #94a3b8; color: var(--text-3); font-weight: 600; margin: 2px 0 8px; }
    .rec-player video { width: 100%; max-height: 260px; border-radius: 10px; background: #000; margin-bottom: 8px; }
    .rec-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .rec-btn {
      flex: 1; min-width: 64px; padding: 9px 8px; border-radius: 9px;
      border: 1px solid #e2e8f0; border: 1px solid var(--border);
      background: #ffffff; background: var(--surface); color: #0f172a; color: var(--text);
      font-family: inherit; font-size: 0.78rem; font-weight: 700; cursor: pointer;
    }
    .rec-send { background: #25d366; color: #fff; border-color: transparent; }
    .rec-del { color: #dc2626; }

    .rec-pill { pointer-events: auto !important; cursor: pointer; }
    .rec-ask {
      position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 160;
      background: rgba(15,23,42,0.6); display: none; align-items: center; justify-content: center; padding: 24px;
    }
    .rec-ask.show { display: -webkit-box; display: -webkit-flex; display: flex; }
    .rec-ask-box {
      background: #ffffff; background: var(--surface); color: #0f172a; color: var(--text);
      border-radius: 20px; padding: 24px 20px; max-width: 340px; width: 100%; text-align: center;
      box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    }
    .rec-ask-icon { color: #dc2626; font-size: 2rem; line-height: 1; margin-bottom: 8px; }
    .rec-ask-text { font-weight: 700; font-size: 1rem; line-height: 1.4; margin-bottom: 18px; }
    /* ===== Today's target lesson highlight ===== */
    .lesson-card.target-lesson {
      border-color: #f59e0b; border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(245,158,11,0.28);
      background: rgba(245,158,11,0.10);
    }
    .target-badge {
      display: inline-block; margin-top: 8px; padding: 3px 9px; border-radius: 20px;
      background: #f59e0b; background: var(--accent); color: #0f172a;
      font-size: 0.68rem; font-weight: 800; letter-spacing: 0.02em;
    }
    .day-pill.target-day { box-shadow: 0 0 0 2px #f59e0b; box-shadow: 0 0 0 2px var(--accent); }
    /* ===== Day banner (Home) ===== */
    .day-banner {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 16px;
      border-radius: var(--radius);
      border: 2px solid var(--border);
      background: var(--surface);
      margin-bottom: 8px;
      font-weight: 700;
      font-size: 0.9rem;
      line-height: 1.3;
    }
    .day-banner-text { flex: 1; min-width: 0; }
    .day-banner.is-open { border-color: var(--accent); background: rgba(245,158,11,0.10); }
    .day-banner.is-done { border-color: var(--success); background: rgba(22,163,74,0.08); }
    .day-banner.is-champion {
      border-color: #a855f7;
      background: linear-gradient(135deg, rgba(168,85,247,0.12), rgba(99,102,241,0.12));
    }
    .day-banner.is-waiting { border-color: var(--border); background: var(--surface-2); color: var(--text-2); }
    .refresh-btn {
      width: 44px; height: 44px; min-width: 44px;
      border-radius: 50%; border: none;
      background: var(--accent); color: #0f172a;
      font-size: 1.3rem; font-weight: 800; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      -webkit-tap-highlight-color: transparent;
    }
    .refresh-btn:active { transform: scale(0.94); }
    .day-banner.is-champion .refresh-btn { background: #a855f7; color: #fff; }
    .day-banner.is-done .refresh-btn { background: var(--success); color: #fff; }
    .day-banner-hint {
      font-size: 0.72rem; color: var(--text-3); font-weight: 600;
      margin-bottom: 14px; padding-left: 4px;
    }
    @media (min-width: 600px) {
      .content-wrap { max-width: 520px; margin: 0 auto; width: 100%; }
    }
  </style>
</head>
<body>
  <!-- PROFILE -->
  <div id="profileScreen" class="screen active">
    <div class="profile-card">
      <div class="logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </div>
      <h2>Decodable Reader 2</h2>
      <p class="sub">Enter your details to begin</p>
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" id="profileName" maxlength="30" placeholder="e.g. Ama Mensah" autocomplete="name" />
        <div class="char-count"><span id="nameCount">0</span>/30</div>
      </div>
      <div class="form-group">
        <label>Grade</label>
        <input type="text" id="profileGrade" maxlength="10" placeholder="e.g. 2" />
      </div>
      <button class="btn btn-primary btn-block btn-lg" id="startBtn">Start Reading</button>
    </div>
  </div>

  <!-- HOME -->
  <div id="homeScreen" class="screen">
    <div class="app-header">
      <h1><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>My Lessons</h1>
      <button class="icon-btn" id="themeBtn" title="Toggle theme" aria-label="Toggle theme"></button>
      <div class="menu-wrap">
        <button class="icon-btn" id="dataMenuBtn" title="Data" aria-label="Data menu" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="overflow-menu" id="dataMenu" role="menu" aria-label="Data options">
          <button class="menu-item" id="exportExcelBtn" role="menuitem">
            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg></span>
            <span class="menu-label">Export Excel</span>
          </button>
          <button type="button" class="menu-item" id="recListBtn" role="menuitem">
            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></span>
            <span class="menu-label">My reading videos</span>
          </button>
          <button class="menu-item" id="backupBtn" role="menuitem">
            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg></span>
            <span class="menu-label">Backup</span>
          </button>
          <button class="menu-item" id="importBtn" role="menuitem">
            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></span>
            <span class="menu-label">Import</span>
          </button>
        </div>
      </div>
    </div>
    <div class="content">
      <div class="content-wrap">
        <div class="student-banner">
          <div class="avatar" id="homeAvatar">?</div>
          <div class="info">
            <div class="name" id="homeName">—</div>
            <div class="grade" id="homeGrade">Grade —</div>
          </div>
        </div>
        <input type="file" id="importFile" accept=".json,application/json" style="display:none" />
        <div class="day-banner" id="dayBanner">
          <span class="day-banner-text" id="dayBannerText">Loading&hellip;</span>
          <button type="button" class="refresh-btn" id="refreshBtn" aria-label="Refresh"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg></button>
        </div>
        <div class="day-banner-hint">Refresh to see latest update</div>
        <div id="lessonList"></div>
      </div>
    </div>
  </div>

  <!-- READING -->
  <div id="readingScreen" class="screen">
    <div class="app-header">
      <button class="icon-btn" id="readBackBtn" title="Back" aria-label="Back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
      </button>
      <span class="day-chip" id="dayChip">Day 1</span>
      <div style="flex:1;min-width:0">
        <h1 id="readTitle" style="font-size:0.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Lesson</h1>
        <div class="meta" id="readMeta"></div>
      </div>
      <button class="icon-btn" id="ttsBarBtn" title="Read aloud" aria-label="Read aloud">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
      </button>
      <div class="menu-wrap">
        <button class="icon-btn" id="menuBtn" title="More options" aria-label="More options" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
        </button>
        <div class="overflow-menu" id="overflowMenu" role="menu" aria-label="Options">
          <button class="menu-item" id="ttsChunkBtn" role="menuitem">
            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg></span>
            <span class="menu-label">Read aloud</span>
          </button>
          <button class="menu-item" id="ttsSpeedBtn" role="menuitem">
            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
            <span class="menu-label" id="ttsSpeedLabel">Audio: Slow</span>
          </button>
          <button class="menu-item" id="segmentBtn" role="menuitem">
            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 8 6l4 14"/><path d="M5.5 15h5"/><path d="M14 6h3a2.5 2.5 0 0 1 0 5h-3z"/><path d="M14 11h3.5a2.5 2.5 0 0 1 0 5H14z"/></svg></span>
            <span class="menu-label">Segment mode</span>
            <span class="menu-check" id="segmentCheck" aria-hidden="true">✓</span>
          </button>
          <button type="button" class="menu-item" id="recToggleBtn" role="menuitem">
            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></span>
            <span class="menu-label">Record my reading</span>
            <span class="menu-check" aria-hidden="true">&#10003;</span>
          </button>
          <div class="menu-divider" role="separator"></div>
          <button class="menu-item" id="themeBtn2" role="menuitem">
            <span class="menu-icon" id="themeIcon2"></span>
            <span class="menu-label">Toggle theme</span>
          </button>
        </div>
      </div>
    </div>
    <div class="content">
      <div class="content-wrap">
        <div class="segment-banner" id="segmentBanner">
          <span class="seg-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 8 6l4 14"/><path d="M5.5 15h5"/><path d="M14 6h3a2.5 2.5 0 0 1 0 5h-3z"/><path d="M14 11h3.5a2.5 2.5 0 0 1 0 5H14z"/></svg>
            Segment mode — tap any word
          </span>
          <button type="button" class="exit-seg" id="exitSegmentBtn">Exit</button>
        </div>
        <div class="target-bar">
          <span class="sound" id="targetSound"></span>
        </div>
        <div class="story-area" id="storyArea"></div>
        <div class="progress-row">
          <span id="wordsLeftLabel">0 words left in this part</span>
          <div class="progress-track"><div class="progress-fill" id="readProgress"></div></div>
        </div>
      </div>
    </div>
    <div class="bottom-bar">
      <button class="btn btn-primary btn-lg btn-block btn-locked" id="goQuestionsBtn" disabled></button>
    </div>
  </div>

  <!-- QUESTIONS -->
  <div id="questionsScreen" class="screen">
    <div class="app-header">
      <button class="icon-btn" id="qBackStoryBtn" title="Back to story" aria-label="Back to story">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </button>
      <div style="flex:1;min-width:0">
        <h1 style="font-size:0.95rem">Questions</h1>
        <div class="meta" id="qMeta"></div>
      </div>
      <button class="icon-btn" id="themeBtn3" title="Toggle theme" aria-label="Toggle theme"></button>
    </div>
    <div class="content">
      <div class="content-wrap">
        <div class="q-progress" id="qProgress">Question 1 of 3</div>
        <div class="q-card">
          <div class="q-text" id="qText"></div>
          <div id="qOptions"></div>
          <div class="feedback-banner" id="qFeedback"></div>
        </div>
      </div>
    </div>
    <div class="bottom-bar">
      <button class="btn btn-outline" id="qToStoryBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
