      </button>
      <div style="flex:1;min-width:0">
        <h1 style="font-size:0.95rem">Sound Hunt</h1>
        <div class="meta" id="shMeta"></div>
      </div>
      <button class="icon-btn" id="themeBtn5" title="Toggle theme" aria-label="Toggle theme"></button>
    </div>
    <div class="content">
      <div class="content-wrap">
        <div class="target-bar">
