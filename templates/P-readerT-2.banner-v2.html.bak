          <div class="feedback-banner" id="shFeedback"></div>
        </div>
      </div>
    </div>
    <div class="bottom-bar">
      <button class="btn btn-primary btn-lg btn-block btn-locked" id="shFinishBtn" disabled></button>
    </div>
  </div>

  <!-- RESULTS -->
  <div id="resultsScreen" class="screen">
