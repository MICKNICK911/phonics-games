  /* ========== CONSTANTS ========== */
  const DAY_COLORS = { 1: 'd1', 2: 'd2', 3: 'd3', 4: 'd4', 5: 'd5' };
  const DAY_HEX = { 1: '#ef4444', 2: '#eab308', 3: '#22c55e', 4: '#3b82f6', 5: '#a855f7' };
  const DAY_TEXT = { 1: '#ffffff', 2: '#0f172a', 3: '#ffffff', 4: '#ffffff', 5: '#ffffff' };
  const CHUNK_SIZE = 3;
  /* ===== TEACHER CONTROLS - edit these each day ===== */
  var TARGET_LESSON_TITLE = 'The Shrew and the Shrub';  /* lesson title, not case-sensitive */
  var OPEN_DAY = 3;                      /* 1 to 5 */
  /* ================================================== */
  var FLAGS_DB_NAME = 'decodable_flags_r2';  /* IndexedDB for the 5 day flags (Reader 1 and Reader 2 differ) */
  const MAX_SUBMITS_PER_DAY = 2;
  const TEACHER_WA = '233545800158';
  const STORAGE_KEY = 'decodable_student_v2';
  // Completion code shown on every results screen. Set to your own code
  // (e.g. 'ABC123'), or '' to hide the box entirely.
  const FINISH_CODE = 'Kgu54F';

  /* ========== STATE ========== */
  let profile = { name: '', grade: '' };
  let progress = {};
  let theme = 'light';
  let ttsSpeed = 'slow';
  let currentLesson = null;
  let currentDay = 1;
  let tappedSet = new Set();
  let visibleChunkStart = 0;
  let visibleChunkEnd = CHUNK_SIZE;
  let quiz = { questions: [], index: 0, correct: 0, answered: false, triedWrong: false };
  let quizTimer = null;
  let lastResult = null;
  let segmentMode = false;
  let segmentModalWord = '';
  let menuOpen = false;
  let soundHunt = { tiles: [], attempts: 0, passed: false, checking: false };
  let soundHuntTimer = null;

  const TTS_RATES = { slow: 0.7, normal: 0.95 };

  /* ========== DAY FLAGS (IndexedDB, per student + lesson) ========== */
  var FlagsMod = (function () {
    var STORE = 'flags';
    var db = null, cache = {}, warned = false;
    var supported = !!window.indexedDB;

    function studentKey(name) { return String(name || '').replace(/^\s+|\s+$/g, '').toLowerCase(); }
    function recKey(name, lessonId) { return studentKey(name) + '|' + lessonId; }
    function blank(name, lessonId) {
      return { key: recKey(name, lessonId), student: studentKey(name), lessonId: lessonId,
               day1: false, day2: false, day3: false, day4: false, day5: false };
    }
    function put(rec) {
      if (!db) return;
      try { db.transaction(STORE, 'readwrite').objectStore(STORE).put(rec); } catch (e) {}
    }
    function warn() {
      if (db || warned) return;
      warned = true;
      try { toast('Progress storage unavailable - days will not be saved', 3500); } catch (e) {}
    }
    function init(cb) {
      var done = false;
      function finish() { if (done) return; done = true; if (cb) cb(); }
      if (!supported) { finish(); return; }
      var req;
      try { req = window.indexedDB.open(FLAGS_DB_NAME, 1); } catch (e) { finish(); return; }
      req.onupgradeneeded = function () {
        try { req.result.createObjectStore(STORE, { keyPath: 'key' }); } catch (e) {}
      };
      req.onsuccess = function () {
        db = req.result;
        try {
          var cur = db.transaction(STORE, 'readonly').objectStore(STORE).openCursor();
          cur.onsuccess = function () {
            var c = cur.result;
            if (c) { cache[c.value.key] = c.value; c['continue'](); }
            else { finish(); }
          };
          cur.onerror = function () { finish(); };
        } catch (e) { finish(); }
      };
      req.onerror = function () { finish(); };
      req.onblocked = function () { finish(); };
    }
    /* A record is created once per student + lesson. Lesson 1 starts with Day 1 = true. */
    function ensure(name, lessonId) {
      var k = recKey(name, lessonId);
      if (!cache[k]) {
        var rec = blank(name, lessonId);
        if (LESSONS.length && lessonId === LESSONS[0].id) rec.day1 = true;
        cache[k] = rec;
        put(rec);
      }
      return cache[k];
    }
    function ensureStudent(name) {
      if (!studentKey(name)) return;
      for (var i = 0; i < LESSONS.length; i++) ensure(name, LESSONS[i].id);
      warn();
    }
    function get(name, lessonId) {
      var r = ensure(name, lessonId);
      return [r.day1 === true, r.day2 === true, r.day3 === true, r.day4 === true, r.day5 === true];
    }
    /* Only ever turns a flag true. Never resets. */
    function setDay(name, lessonId, day) {
      if (!(day >= 1 && day <= 5)) return false;
      var r = ensure(name, lessonId);
      if (r['day' + day] === true) return false;
      r['day' + day] = true;
      put(r);
      return true;
    }
    function count(name, lessonId) {
      var f = get(name, lessonId), n = 0;
      for (var i = 0; i < 5; i++) if (f[i]) n++;
      return n;
    }
    function allDone(name, lessonId) { return count(name, lessonId) === 5; }
    function summary(name, lessonId) {
      var f = get(name, lessonId), out = [];
      for (var i = 0; i < 5; i++) out.push((i + 1) + (f[i] ? '\u2713' : '\u2717'));
      return out.join(' ');
    }
    function exportAll() {
      var out = [];
      for (var k in cache) {
        if (Object.prototype.hasOwnProperty.call(cache, k)) out.push(cache[k]);
      }
      return out;
    }
    function importAll(list) {
      if (!Array.isArray(list)) return;
      cache = {};
      var os = null;
      if (db) {
        try { os = db.transaction(STORE, 'readwrite').objectStore(STORE); os.clear(); } catch (e) { os = null; }
      }
      for (var i = 0; i < list.length; i++) {
        var r = list[i];
        if (!r || typeof r.key !== 'string' || typeof r.lessonId !== 'string') continue;
        var rec = { key: r.key, student: String(r.student || ''), lessonId: r.lessonId,
                    day1: r.day1 === true, day2: r.day2 === true, day3: r.day3 === true,
                    day4: r.day4 === true, day5: r.day5 === true };
        cache[rec.key] = rec;
        if (os) { try { os.put(rec); } catch (e) {} }
      }
    }
    return { init: init, ensureStudent: ensureStudent, get: get, setDay: setDay, count: count,
             allDone: allDone, summary: summary, exportAll: exportAll, importAll: importAll };
  })();

  /* ========== STORAGE ========== */
  function loadStore() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      if (data.profile && typeof data.profile === 'object') profile = data.profile;
      if (data.progress && typeof data.progress === 'object') progress = data.progress;
      if (data.theme === 'dark' || data.theme === 'light') theme = data.theme;
      if (data.ttsSpeed === 'slow' || data.ttsSpeed === 'normal') ttsSpeed = data.ttsSpeed;
    } catch (e) {}
  }
  function saveStore() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ profile, progress, theme, ttsSpeed }));
    } catch (e) {}
  }

  function getProg(id) {
    const defaults = {
      highestDay: 0,
      bestScores: {},
      submits: {},
      currentTapped: [],
      readingDone: false,
      lastPlayDate: '',
      lastPlayDay: 0
    };
    const existing = progress[id];
    if (!existing || typeof existing !== 'object' || Array.isArray(existing)) {
      progress[id] = defaults;
      return progress[id];
    }
    existing.highestDay = Number.isFinite(existing.highestDay) ? existing.highestDay : 0;
    existing.bestScores = (existing.bestScores && typeof existing.bestScores === 'object' && !Array.isArray(existing.bestScores)) ? existing.bestScores : {};
    existing.submits = (existing.submits && typeof existing.submits === 'object' && !Array.isArray(existing.submits)) ? existing.submits : {};
    existing.currentTapped = Array.isArray(existing.currentTapped) ? existing.currentTapped : [];
    existing.readingDone = !!existing.readingDone;
    existing.lastPlayDate = (typeof existing.lastPlayDate === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(existing.lastPlayDate))
      ? existing.lastPlayDate
      : '';
    existing.lastPlayDay = (Number.isFinite(existing.lastPlayDay) && existing.lastPlayDay >= 1 && existing.lastPlayDay <= 5)
      ? existing.lastPlayDay
      : 0;
    return existing;
  }

  function todayKey() {
    const d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }

  /* ========== THEME ========== */
  function applyTheme() {
    document.documentElement.setAttribute('data-theme', theme);
    const svg = theme === 'dark' ? ICONS.sun : ICONS.moon;
    /* Whole-button icons (home + other screens) — themeBtn2 is now a menu
       item with children, so it is handled separately below. */
    ['themeBtn', 'themeBtn3', 'themeBtn4', 'themeBtn5'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = svg;
    });
    /* Menu item on the reading screen: update only its icon span. */
    const icon = document.getElementById('themeIcon2');
    if (icon) icon.innerHTML = svg;
  }
  function toggleTheme() {
    theme = theme === 'dark' ? 'light' : 'dark';
    applyTheme();
    saveStore();
  }

  /* ========== NAV ========== */
  function showScreen(id) {
    closeOverflowMenu(); /* safe no-op if not open */
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    const el = document.getElementById(id);
    if (el) el.classList.add('active');
    window.scrollTo(0, 0);
    if (typeof RecMod !== 'undefined' && RecMod) RecMod.onScreen(id);
  }

  function toast(msg, ms) {
    const t = document.getElementById('toast');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toast._tm);
    toast._tm = setTimeout(() => t.classList.remove('show'), ms || 2800);
  }

  /* ========== OVERFLOW MENU ========== */
  function openOverflowMenu() {
    const menu = document.getElementById('overflowMenu');
    const btn = document.getElementById('menuBtn');
    if (!menu || !btn) return;
    menuOpen = true;
    menu.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
  }
  function closeOverflowMenu() {
    const menu = document.getElementById('overflowMenu');
    const btn = document.getElementById('menuBtn');
    if (!menu || !btn) return;
    menuOpen = false;
    menu.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
  }
  function toggleOverflowMenu() {
    if (menuOpen) closeOverflowMenu();
    else openOverflowMenu();
  }

  /* ========== PROFILE ========== */
  document.getElementById('profileName').addEventListener('input', function () {
    document.getElementById('nameCount').textContent = this.value.length;
  });
  document.getElementById('startBtn').addEventListener('click', function () {
    const name = document.getElementById('profileName').value.trim();
    const grade = document.getElementById('profileGrade').value.trim();
    if (!name) return toast('Please enter your full name');
    if (!grade) return toast('Please enter your grade');
    if (name.length > 30) return toast('Name must be 30 characters or less');
    profile = { name, grade };
    saveStore();
    FlagsMod.ensureStudent(profile.name);
    renderHome();
    showScreen('homeScreen');
  });

  /* ========== HOME ========== */
  var homeScrolledOnce = false;

  function renderDayBanner() {
    var banner = document.getElementById('dayBanner');
    var text = document.getElementById('dayBannerText');
    if (!banner || !text) return;

    var lesson = null;
    for (var i = 0; i < LESSONS.length; i++) {
      if (isTargetLesson(LESSONS[i])) { lesson = LESSONS[i]; break; }
    }

    banner.className = 'day-banner';

    if (!lesson) {
      text.textContent = 'Waiting for teacher to set today\u2019s lesson';
      banner.className = 'day-banner is-waiting';
      return;
    }

    var openDay = targetDay();
    var flags = FlagsMod.get(profile.name, lesson.id);
    var currentDayDone = flags[openDay - 1] === true;
    var allDone = FlagsMod.count(profile.name, lesson.id) === 5;

    if (allDone) {
      text.textContent = '\uD83C\uDFC6 All 5 days complete \u2014 Champion!';
      banner.className = 'day-banner is-champion';
    } else if (currentDayDone) {
      text.textContent = 'Day ' + openDay + ' complete \u2713 \u2014 waiting for teacher';
      banner.className = 'day-banner is-done';
    } else {
      text.textContent = 'Day ' + openDay + ' is open \u2014 read it now!';
      banner.className = 'day-banner is-open';
    }
  }

  function renderHome() {
    document.getElementById('homeName').textContent = profile.name || '\u2014';
    document.getElementById('homeGrade').textContent = 'Grade ' + (profile.grade || '\u2014');
    document.getElementById('homeAvatar').textContent = ((profile.name && profile.name.charAt(0)) || '?').toUpperCase();

    var list = document.getElementById('lessonList');
    list.innerHTML = '';
    var targetCard = null;

    LESSONS.forEach(function (l) {
      var flags = FlagsMod.get(profile.name, l.id);
      var doneCount = 0;
      for (var i = 0; i < 5; i++) { if (flags[i]) doneCount++; }
      var mastered = doneCount === 5;
      var isTarget = isTargetLesson(l);

      var card = document.createElement('div');
      card.className = 'lesson-card' + (mastered ? ' mastered' : '') + (isTarget ? ' target-lesson' : '');

      var pills = '';
      for (var d = 1; d <= 5; d++) {
        pills += '<span class="day-pill ' + (flags[d - 1] ? 'done d' + d : '') +
                 (isTarget && d === targetDay() ? ' target-day' : '') + '">' + d + '</span>';
      }

      card.innerHTML =
        '<div class="lesson-num">' + l.lessonNumber + '</div>' +
        '<div class="lesson-body">' +
          '<div class="lesson-title">' + esc(l.title) + '</div>' +
          '<div class="lesson-sound">' + ICONS.target + esc(l.targetSound) + '</div>' +
          '<div class="day-pills">' + pills + '<span class="day-label">' + doneCount + '/5 days</span></div>' +
          (mastered ? '<div class="mastered-badge">' + ICONS.trophy + '5-Day Champion</div>' : '') +
          (isTarget ? '<div class="target-badge">Today\u2019s lesson \u00B7 Day ' + targetDay() + '</div>' : '') +
        '</div>';

      card.onclick = function () { openLesson(l.id); };
      if (isTarget) targetCard = card;
      list.appendChild(card);
    });

    renderDayBanner();

    if (targetCard && !homeScrolledOnce) {
      homeScrolledOnce = true;
      setTimeout(function () {
        try { targetCard.scrollIntoView({ block: 'center' }); }
        catch (e) { try { targetCard.scrollIntoView(); } catch (e2) {} }
      }, 120);
    }
  }

  /* ========== READING ========== */
  function isTargetLesson(l) {
    if (!l) return false;
    var a = String(l.title).replace(/^\s+|\s+$/g, '').toLowerCase();
    var b = String(TARGET_LESSON_TITLE).replace(/^\s+|\s+$/g, '').toLowerCase();
    return a === b;
  }

  function targetDay() {
    var d = parseInt(OPEN_DAY, 10);
    return (d >= 1 && d <= 5) ? d : 1;
  }

  /* Called when the full cycle (reading + questions + Sound Hunt) is passed. */
  function completeCycle() {
    if (!lastResult || !lastResult.passed) return;

    if (!isTargetLesson(currentLesson) || lastResult.day !== targetDay()) {
      lastResult.counted = false;
      lastResult.alreadyCounted = false;
      return;
    }

    var flags = FlagsMod.get(profile.name, currentLesson.id);
    var had = flags[lastResult.day - 1] === true;
    var earned = FlagsMod.setDay(profile.name, currentLesson.id, lastResult.day);

    lastResult.counted = earned;
    lastResult.alreadyCounted = had && !earned;
  }

  function openLesson(id) {
    var found = null;
    for (var i = 0; i < LESSONS.length; i++) {
      if (LESSONS[i].id === id) { found = LESSONS[i]; break; }
    }
    currentLesson = found;
    if (!currentLesson) return;

    var p = getProg(id);
    currentDay = targetDay();
    p.lastPlayDate = todayKey();
    p.lastPlayDay = currentDay;

    /* a half-finished read from a different day must not carry over */
    if (p.tappedDay !== currentDay) {
      p.currentTapped = [];
      p.tappedDay = currentDay;
    }
    saveStore();

    if (isTargetLesson(currentLesson)) {
      if (FlagsMod.get(profile.name, id)[currentDay - 1]) {
        toast('Day ' + currentDay + ' already complete \u2014 replay', 2600);
      } else {
        toast('Today\u2019s lesson \u2014 Day ' + currentDay, 2400);
      }
    } else {
      toast('Practice only \u2014 not today\u2019s lesson', 2800);
    }

    tappedSet = new Set(p.currentTapped || []);
    recomputeVisibleChunk();
    exitSegmentMode();
    stopTTS();
    renderReading();
    showScreen('readingScreen');
  }

  function tokenize(sentence) {
    return String(sentence || '').trim().split(/\s+/).filter(Boolean);
  }

  function recomputeVisibleChunk() {
    const lines = currentLesson.storyLines || [];
    let end = Math.min(CHUNK_SIZE, lines.length);
    while (end < lines.length) {
      let allPrevTapped = true;
      for (let li = 0; li < end && allPrevTapped; li++) {
        const words = tokenize(lines[li]);
        for (let wi = 0; wi < words.length; wi++) {
          if (!tappedSet.has(li + '-' + wi)) { allPrevTapped = false; break; }
        }
      }
      if (allPrevTapped) end = Math.min(end + CHUNK_SIZE, lines.length);
      else break;
    }
    visibleChunkEnd = end;
    visibleChunkStart = end > 0 ? Math.floor((end - 1) / CHUNK_SIZE) * CHUNK_SIZE : 0;
  }

  function totalWords() {
    return currentLesson.storyLines.reduce((n, s) => n + tokenize(s).length, 0);
  }

  function tappedCount() { return tappedSet.size; }

  function wordsLeftInVisibleChunk() {
    let left = 0;
    for (let li = visibleChunkStart; li < visibleChunkEnd; li++) {
      const words = tokenize(currentLesson.storyLines[li]);
      for (let wi = 0; wi < words.length; wi++) {
        if (!tappedSet.has(li + '-' + wi)) left++;
      }
    }
    return left;
  }

  function allWordsTapped() { return tappedCount() >= totalWords(); }

  function renderReading() {
    const l = currentLesson;
    document.getElementById('readTitle').textContent = 'Lesson ' + l.lessonNumber + ' — ' + l.title;
    document.getElementById('readMeta').textContent = profile.name + ' · Grade ' + profile.grade;
    document.getElementById('targetSound').textContent = 'Target: ' + l.targetSound;

    const chip = document.getElementById('dayChip');
    chip.textContent = 'Day ' + currentDay;
    chip.style.background = DAY_HEX[currentDay];
    chip.style.color = DAY_TEXT[currentDay];

    const area = document.getElementById('storyArea');
    area.innerHTML = '';
    l.storyLines.forEach((sentence, li) => {
      const lineEl = document.createElement('div');
      lineEl.className = 'story-line';
      if (li >= visibleChunkEnd) lineEl.classList.add('hidden-chunk');
      else if (li < visibleChunkStart) lineEl.classList.add('dimmed');

      const words = tokenize(sentence);
      words.forEach((w, wi) => {
        const key = li + '-' + wi;
        const span = document.createElement('span');
        span.className = 'word';
        span.textContent = w;
        span.dataset.key = key;
        if (tappedSet.has(key)) span.classList.add('tapped', DAY_COLORS[currentDay]);
        span.addEventListener('click', () => onWordTap(key, span));
        lineEl.appendChild(span);
      });
      area.appendChild(lineEl);
    });

    updateReadProgress();
  }

  function onWordTap(key, el) {
    const li = parseInt(key.split('-')[0], 10);
    if (li >= visibleChunkEnd) return;

    if (segmentMode) { openSegmentModal(el.textContent); return; }
    if (tappedSet.has(key)) return;

    tappedSet.add(key);
    el.classList.add('tapped', DAY_COLORS[currentDay]);

    const p = getProg(currentLesson.id);
    p.currentTapped = Array.from(tappedSet);
    saveStore();

    if (wordsLeftInVisibleChunk() === 0 && visibleChunkEnd < currentLesson.storyLines.length) {
      visibleChunkStart = visibleChunkEnd;
      visibleChunkEnd = Math.min(visibleChunkEnd + CHUNK_SIZE, currentLesson.storyLines.length);
      renderReading();
      toast('Nice! Next part unlocked');
    } else {
      updateReadProgress();
    }
  }

  function updateReadProgress() {
    const total = totalWords();
    const done = tappedCount();
    const pct = total ? Math.round((done / total) * 100) : 0;
    document.getElementById('readProgress').style.width = pct + '%';

    const left = wordsLeftInVisibleChunk();
    document.getElementById('wordsLeftLabel').textContent =
      left > 0
        ? left + ' word' + (left === 1 ? '' : 's') + ' left in this part'
        : (done < total ? 'Unlocking next part…' : 'All words read!');

    const btn = document.getElementById('goQuestionsBtn');
    if (allWordsTapped()) {
      btn.disabled = false;
      btn.classList.remove('btn-locked');
      btn.innerHTML = ICONS.check + 'Answer Questions';
      const p = getProg(currentLesson.id);
      p.readingDone = true;
      p.currentTapped = Array.from(tappedSet);
      saveStore();
    } else {
      btn.disabled = true;
      btn.classList.add('btn-locked');
      btn.innerHTML = ICONS.lock + 'Finish reading first';
    }
  }

  document.getElementById('goQuestionsBtn').addEventListener('click', () => {
    exitSegmentMode();
    startQuiz();
  });
  document.getElementById('readBackBtn').addEventListener('click', () => {
    exitSegmentMode();
    stopTTS();
    renderHome();
    showScreen('homeScreen');
  });

  /* ========== TTS ========== */
  function stopTTS() {
    try { if (window.speechSynthesis) window.speechSynthesis.cancel(); } catch (e) {}
  }
  function currentTtsRate() { return TTS_RATES[ttsSpeed] || TTS_RATES.slow; }

  function updateSpeedBtn() {
    const btn = document.getElementById('ttsSpeedBtn');
    const label = document.getElementById('ttsSpeedLabel');
    if (!btn) return;
    if (ttsSpeed === 'slow') {
      if (label) label.textContent = 'Audio: Slow';
      btn.classList.add('is-slow');
    } else {
      if (label) label.textContent = 'Audio: Normal';
      btn.classList.remove('is-slow');
    }
  }
  function toggleTtsSpeed() {
    ttsSpeed = ttsSpeed === 'slow' ? 'normal' : 'slow';
    saveStore();
    updateSpeedBtn();
    toast(ttsSpeed === 'slow' ? 'Audio: Slow' : 'Audio: Normal', 1800);
  }

  function speakText(text) {
    if (!text || !window.speechSynthesis) {
      toast('Speech not available on this device');
      return;
    }
    stopTTS();
    const u = new SpeechSynthesisUtterance(String(text));
    u.lang = 'en-US';
    u.rate = currentTtsRate();
    u.pitch = 1;
    try {
      const voices = window.speechSynthesis.getVoices() || [];
      const preferred = voices.find(v =>
        /en(-|_)US/i.test(v.lang) && /samantha|google us|allison|ava|susan|zira/i.test(v.name)
      ) || voices.find(v => /en(-|_)GB/i.test(v.lang)) || voices.find(v => /^en/i.test(v.lang));
      if (preferred) u.voice = preferred;
    } catch (e) {}
    window.speechSynthesis.speak(u);
  }

  if (window.speechSynthesis) {
    try { window.speechSynthesis.getVoices(); } catch (e) {}
    window.speechSynthesis.onvoiceschanged = function () {
      try { window.speechSynthesis.getVoices(); } catch (e) {}
    };
  }

  function speakCurrentChunk() {
    if (!currentLesson) return;
    const lines = (currentLesson.storyLines || []).slice(visibleChunkStart, visibleChunkEnd);
    const text = lines.join(' ').trim();
    if (!text) return;
    speakText(text);
  }  document.getElementById('ttsChunkBtn').addEventListener('click', speakCurrentChunk);
  document.getElementById('ttsSpeedBtn').addEventListener('click', toggleTtsSpeed);
  const _ttsBarBtn = document.getElementById('ttsBarBtn');
  if (_ttsBarBtn) _ttsBarBtn.addEventListener('click', speakCurrentChunk);

  /* ========== SEGMENT MODE ========== */
  function setSegmentMode(on) {
    segmentMode = !!on;
    const screen = document.getElementById('readingScreen');
    const btn = document.getElementById('segmentBtn');
    if (segmentMode) {
      screen.classList.add('segment-mode');
      btn.classList.add('active-seg');
      toast('Segment mode on — tap any word', 2200);
    } else {
      screen.classList.remove('segment-mode');
      btn.classList.remove('active-seg');
      closeSegmentModal();
    }
  }
  function exitSegmentMode() { if (segmentMode) setSegmentMode(false); }

  document.getElementById('segmentBtn').addEventListener('click', () => setSegmentMode(!segmentMode));
  document.getElementById('exitSegmentBtn').addEventListener('click', exitSegmentMode);

  function openSegmentModal(wordText) {
    const clean = String(wordText || '').replace(/[.,!?;:'"]+$/g, '');
    segmentModalWord = clean || String(wordText || '');
    const box = document.getElementById('segmentWord');
    box.innerHTML = '';
    const colors = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#3b82f6', '#6366f1', '#a855f7', '#ffffff'];
    Array.from(segmentModalWord).forEach(ch => {
      const s = document.createElement('span');
      s.className = 'segment-letter';
      s.textContent = ch === ' ' ? '\u00A0' : ch;
      let letterIndex = 0;
      s.addEventListener('click', e => {
        e.stopPropagation();
        s.style.color = colors[letterIndex % colors.length];
        letterIndex++;
      });
      box.appendChild(s);
    });
    document.getElementById('segmentOverlay').classList.add('show');
  }
  function closeSegmentModal() {
    document.getElementById('segmentOverlay').classList.remove('show');
    stopTTS();
  }
  document.getElementById('segmentOverlay').addEventListener('click', function (e) {
    if (e.target === this) closeSegmentModal();
  });
  document.getElementById('segmentCloseBtn').addEventListener('click', closeSegmentModal);
  document.getElementById('segmentPlayBtn').addEventListener('click', function (e) {
    e.stopPropagation();
    speakText(segmentModalWord);
  });
  document.getElementById('segmentInner').addEventListener('click', function (e) {
    e.stopPropagation();
  });

  /* ========== QUIZ ========== */
  function clearQuizTimer() {
    if (quizTimer) { clearTimeout(quizTimer); quizTimer = null; }
  }

  function startQuiz() {
    if (!allWordsTapped()) return;

    const isResume = quiz.active
      && quiz.lessonId === currentLesson.id
      && quiz.day === currentDay
      && Array.isArray(quiz.questions) && quiz.questions.length > 0
      && quiz.attemptedCorrect;

    if (!isResume) {
      const raw = (currentLesson.questions || []).filter(q =>
        q && q.question && Array.isArray(q.options) &&
        q.options.filter(o => o && String(o).trim()).length >= 2
      );
      if (!raw.length) { toast('No questions for this lesson'); return; }
      quiz.questions = raw.map(q => {
        const opts = q.options.map(o => String(o).trim()).filter(Boolean);
        const ci = Math.min(Math.max(0, Number(q.correctIndex) || 0), opts.length - 1);
        const correctText = opts[ci];
        const shuffled = shuffle(opts.slice());
        return { question: q.question, options: shuffled, correctIndex: shuffled.indexOf(correctText) };
      });
      quiz.index = 0;
      quiz.correct = 0;
      quiz.answered = false;
      quiz.attemptedCorrect = new Set();
      quiz.wrongQIndices = new Set();
      quiz.active = true;
      quiz.lessonId = currentLesson.id;
      quiz.day = currentDay;
    } else {
      let firstUnanswered = 0;
      while (firstUnanswered < quiz.questions.length && quiz.attemptedCorrect.has(firstUnanswered)) {
        firstUnanswered++;
      }
      quiz.index = firstUnanswered;
      quiz.answered = false;
      if (quiz.index >= quiz.questions.length) {
        finishQuiz();
        return;
      }
    }
    clearQuizTimer();
    renderQuestion();
    showScreen('questionsScreen');
  }

  function shuffle(a) {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function renderQuestion() {
    clearQuizTimer();
    const q = quiz.questions[quiz.index];
    document.getElementById('qProgress').textContent = 'Question ' + (quiz.index + 1) + ' of ' + quiz.questions.length;
    document.getElementById('qMeta').textContent = profile.name + ' · Day ' + currentDay;
    document.getElementById('qText').textContent = q.question;

    const box = document.getElementById('qOptions');
    box.innerHTML = '';
    const fb = document.getElementById('qFeedback');
    fb.className = 'feedback-banner';
    fb.textContent = '';

    quiz.answered = false;
    quiz.triedWrong = false;

    q.options.forEach((opt, i) => {
      const b = document.createElement('button');
      b.className = 'q-opt';
      b.textContent = opt;
      b.addEventListener('click', () => onAnswer(i, b));
      box.appendChild(b);
    });
  }

  function onAnswer(chosen, btn) {
    if (quiz.answered) return;
    const q = quiz.questions[quiz.index];
    const correct = chosen === q.correctIndex;
    quiz.answered = true;

    const opts = document.querySelectorAll('#qOptions .q-opt');
    opts.forEach(el => { el.disabled = true; });

    const fb = document.getElementById('qFeedback');

    if (correct) {
      if (opts[chosen]) opts[chosen].classList.add('correct');
      quiz.correct++;
      quiz.attemptedCorrect.add(quiz.index);
      fb.textContent = '✓ Correct!';
      fb.className = 'feedback-banner show ok';
      clearQuizTimer();
      quizTimer = setTimeout(() => { quizTimer = null; advanceQuiz(); }, 900);
    } else {
      quiz.wrongQIndices.add(quiz.index);
      if (opts[chosen]) opts[chosen].classList.add('wrong');
      clearQuizTimer();
      quizTimer = setTimeout(() => {
        quizTimer = null;
        showWrongModal();
      }, 600);
    }
  }

  function showWrongModal() {
    const overlay = document.getElementById('wrongModalOverlay');
    if (overlay) overlay.classList.add('show');
  }

  function hideWrongModal() {
    const overlay = document.getElementById('wrongModalOverlay');
    if (overlay) overlay.classList.remove('show');
  }

  function exitWrongModalToStory() {
    hideWrongModal();
    renderReading();
    showScreen('readingScreen');
  }

  function advanceQuiz() {
    if (quiz.index < quiz.questions.length - 1) {
      quiz.index++;
      renderQuestion();
    } else {
      finishQuiz();
    }
  }

  function finishQuiz() {
    clearQuizTimer();
    const total = quiz.questions.length;
    const wrongs = quiz.wrongQIndices ? quiz.wrongQIndices.size : 0;
    const score = Math.max(0, total - wrongs);
    const pct = total ? Math.round((score / total) * 100) : 0;
    const passed = wrongs <= 1;

    const p = getProg(currentLesson.id);
    const prev = p.bestScores[currentDay] || 0;
    if (score > prev) p.bestScores[currentDay] = score;

    p.currentTapped = [];
    p.readingDone = false;
    quiz.active = false;
    saveStore();

    lastResult = {
      lessonId: currentLesson.id,
      lessonNumber: currentLesson.lessonNumber,
      title: currentLesson.title,
      targetSound: currentLesson.targetSound,
      day: currentDay,
      score, total, pct, passed,
      isTarget: isTargetLesson(currentLesson),
      counted: false,
      alreadyCounted: false,
      date: new Date(),
      soundHuntAttempts: null
    };

    if (passed && hasSoundHuntData(currentLesson)) {
      startSoundHunt();
      showScreen('soundHuntScreen');
    } else {
      completeCycle();
      renderResults();
      showScreen('resultsScreen');
    }
  }

  function hasSoundHuntData(lesson) {
    return lesson &&
      Array.isArray(lesson.targetWords) && lesson.targetWords.length >= 5 &&
      Array.isArray(lesson.decoyWords)  && lesson.decoyWords.length  >= 5;
  }

  document.getElementById('qBackStoryBtn').addEventListener('click', () => {
    clearQuizTimer(); renderReading(); showScreen('readingScreen');
  });  document.getElementById('qToStoryBtn').addEventListener('click', () => {
    clearQuizTimer(); renderReading(); showScreen('readingScreen');
  });

  const _wrongModalBtn = document.getElementById('wrongModalBtn');
  if (_wrongModalBtn) _wrongModalBtn.addEventListener('click', exitWrongModalToStory);

  /* ========== SOUND HUNT ========== */
  function clearSoundHuntTimer() {
    if (soundHuntTimer) { clearTimeout(soundHuntTimer); soundHuntTimer = null; }
  }

  function shortTargetSound(s) {
    const str = String(s || '').trim();
    const idx = str.lastIndexOf(':');
    return idx >= 0 ? str.slice(idx + 1).trim() : str;
  }

  function startSoundHunt() {
    clearSoundHuntTimer();
    if (!hasSoundHuntData(currentLesson)) return;

    const targets = currentLesson.targetWords.slice(0, 5);
    const decoys  = currentLesson.decoyWords.slice(0, 5);
    const tiles = [];
    targets.forEach(w => tiles.push({ word: String(w), isTarget: true,  selected: false }));
    decoys.forEach(w  => tiles.push({ word: String(w), isTarget: false, selected: false }));

    soundHunt.tiles = shuffle(tiles);
    soundHunt.attempts = 0;
    soundHunt.passed = false;
    soundHunt.checking = false;

    renderSoundHunt();
  }

  function renderSoundHunt() {
    if (!currentLesson) return;

    document.getElementById('shMeta').textContent = profile.name + ' · Day ' + currentDay;

    const chip = document.getElementById('shDayChip');
    chip.textContent = 'Day ' + currentDay;
    chip.style.background = DAY_HEX[currentDay];
    chip.style.color = DAY_TEXT[currentDay];

    document.getElementById('shTargetSound').textContent = 'Target: ' + currentLesson.targetSound;

    const soundSpan = '<span class="sh-sound">' + esc(shortTargetSound(currentLesson.targetSound)) + '</span>';
    document.getElementById('shInstruction').innerHTML = currentLesson.huntPrompt
      ? esc(currentLesson.huntPrompt)
      : 'Tap the 5 words that have the ' + soundSpan + ' sound.';

    const grid = document.getElementById('shGrid');
    grid.innerHTML = '';
    soundHunt.tiles.forEach((tile, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'sh-tile';
      btn.dataset.idx = String(idx);
      btn.textContent = tile.word;
      if (tile.selected) btn.classList.add('selected');
      btn.addEventListener('click', () => onShTileTap(idx));
      grid.appendChild(btn);
    });

    updateShCounter();
    updateShFeedback();
    updateShFinishBtn();
  }

  function onShTileTap(idx) {
    if (soundHunt.checking || soundHunt.passed) return;
    const tile = soundHunt.tiles[idx];
    if (!tile) return;

    const fb = document.getElementById('shFeedback');
    if (fb && fb.classList.contains('show') && !fb.classList.contains('ok')) {
      fb.className = 'feedback-banner';
      fb.textContent = '';
    }

    tile.selected = !tile.selected;

    const btn = document.querySelector('.sh-tile[data-idx="' + idx + '"]');
    if (btn) {
      if (tile.selected) btn.classList.add('selected');
      else btn.classList.remove('selected');
    }

    updateShCounter();

    if (selectedShCount() === 5) runSoundHuntCheck();
  }

  function selectedShCount() { return soundHunt.tiles.filter(t => t.selected).length; }

  function runSoundHuntCheck() {
    soundHunt.checking = true;
    soundHunt.attempts++;

    const wrongIdxs = [];
    soundHunt.tiles.forEach((t, i) => {
      if (t.selected && !t.isTarget) wrongIdxs.push(i);
    });

    if (wrongIdxs.length === 0) {
      soundHunt.passed = true;
      soundHunt.checking = false;
      if (lastResult) lastResult.soundHuntAttempts = soundHunt.attempts;
      updateShFeedback();
      updateShFinishBtn();
      return;
    }

    wrongIdxs.forEach(i => {
      const btn = document.querySelector('.sh-tile[data-idx="' + i + '"]');
      if (btn) btn.classList.add('wrong');
    });
    updateShFeedback();

    clearSoundHuntTimer();
    soundHuntTimer = setTimeout(() => {
      soundHuntTimer = null;
      wrongIdxs.forEach(i => {
        const t = soundHunt.tiles[i];
        if (!t) return;
        t.selected = false;
        const btn = document.querySelector('.sh-tile[data-idx="' + i + '"]');
        if (btn) btn.classList.remove('wrong', 'selected');
      });
      soundHunt.checking = false;
      updateShCounter();
      updateShFeedback();
    }, 1200);
  }

  function updateShCounter() {
    document.getElementById('shCounter').textContent = selectedShCount() + ' of 5 selected';
  }

  function updateShFeedback() {
    const fb = document.getElementById('shFeedback');
    if (!fb) return;
    if (soundHunt.passed) {
      fb.textContent = '✓ All 5 target words found!';
      fb.className = 'feedback-banner show ok';
    } else if (soundHunt.checking) {
      fb.textContent = '✗ Not quite — try again';
      fb.className = 'feedback-banner show bad';
    } else {
      fb.className = 'feedback-banner';
      fb.textContent = '';
    }
  }

  function updateShFinishBtn() {
    const btn = document.getElementById('shFinishBtn');
    if (!btn) return;
    if (soundHunt.passed) {
      btn.disabled = false;
      btn.classList.remove('btn-locked');
      btn.innerHTML = ICONS.check + 'See Results';
    } else {
      btn.disabled = true;
      btn.classList.add('btn-locked');
      btn.innerHTML = ICONS.lock + 'Find all 5 words';
    }
  }

  function finishSoundHunt() {
    if (!soundHunt.passed) return;
    completeCycle();
    if (lastResult) lastResult.soundHuntAttempts = soundHunt.attempts;
    renderResults();
    showScreen('resultsScreen');
  }

  document.getElementById('shFinishBtn').addEventListener('click', finishSoundHunt);

  document.getElementById('shBackBtn').addEventListener('click', () => {
    clearSoundHuntTimer();
    renderReading();
    showScreen('readingScreen');
  });

  /* ========== RESULTS ========== */
  function renderResults() {
    const r = lastResult;
    if (!r) return;

    try { localStorage.setItem('decodable_lastResult', JSON.stringify(r)); } catch (e) {}

    const scoreEl = document.getElementById('resScore');
    scoreEl.textContent = r.score + '/' + r.total;
    scoreEl.className = 'score-big ' + (r.passed ? 'pass' : 'fail');

    const subEl = document.getElementById('resSubtitle');
    if (subEl) {
      subEl.textContent = r.passed
        ? '✓ Day ' + r.day + ' · Passed'
        : '✗ Day ' + r.day + ' · Keep practicing';
      subEl.className = 'res-subtitle ' + (r.passed ? 'pass' : 'fail');
    }

    document.getElementById('resLine1').textContent =
      profile.name + ' · Grade ' + profile.grade + ' · ' + formatDate(r.date);
    document.getElementById('resLine2').textContent =
      'Lesson ' + r.lessonNumber + ' — ' + r.title;
    document.getElementById('resLine3').textContent = r.targetSound;

    const line4 = document.getElementById('resLine4');
    if (typeof r.soundHuntAttempts === 'number') {
      line4.style.display = '';
      line4.textContent = '🎯 Sound Hunt · ' +
        (r.soundHuntAttempts === 1 ? 'First try' : r.soundHuntAttempts + ' tries');
    } else {
      line4.style.display = 'none';
    }

    var fl = FlagsMod.get(profile.name, r.lessonId);
    var pills = document.getElementById('resDayPills');
    pills.innerHTML = '';
    for (var d = 1; d <= 5; d++) {
      var s = document.createElement('span');
      var isOn = fl[d - 1];
      s.className = 'dp' + (isOn ? ' done d' + d : '');
      if (isOn) {
        s.style.background = DAY_HEX[d];
        s.style.color = DAY_TEXT[d];
      }
      s.textContent = String(d);
      pills.appendChild(s);
    }

    var champ = document.getElementById('resChamp');
    champ.className = FlagsMod.allDone(profile.name, r.lessonId) ? 'champ show' : 'champ';

    var line5 = document.getElementById('resLine5');
    if (line5) {
      var msg = '';
      if (r.counted) msg = '\u2605 Day ' + r.day + ' counted for this lesson';
      else if (r.alreadyCounted) msg = '\u2713 Day ' + r.day + ' already earned \u2014 replay doesn\'t count again';
      else if (!r.passed) msg = 'Not counted \u2014 pass the questions and Sound Hunt to earn the day';
      else if (!r.isTarget) msg = 'Practice lesson \u2014 not today\u2019s target, so no day earned';
      else msg = '\u26A0 Day mismatch \u2014 refresh the app and try again';
      line5.textContent = msg;
      line5.style.display = msg ? '' : 'none';
    }

    const fcBox = document.getElementById('resFinishCodeBox');
    const fcVal = document.getElementById('resFinishCode');
    if (fcBox && fcVal) {
      const code = String(FINISH_CODE || '').replace(/^\s+|\s+$/g, '');
      if (code) {
        fcBox.style.display = '';
        fcVal.textContent = code;
        fcBox.onclick = copyFinishCode;
      } else {
        fcBox.style.display = 'none';
      }
    }

    updateSubmitButton();
  }

  function formatDate(d) {
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
  }

  function copyFinishCode() {
    var code = String(FINISH_CODE || '').replace(/^\s+|\s+$/g, '');
    if (!code) return;
    var el = document.getElementById('resFinishCode');
    if (!el) return;
    var showCopied = function () {
      el.textContent = 'Copied!';
      clearTimeout(el._copyTimer);
      el._copyTimer = setTimeout(function () { el.textContent = code; }, 1200);
    };
    var fallback = function () {
      try {
        var ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = document.execCommand('copy');
        document.body.removeChild(ta);
        if (ok) showCopied(); else toast('Copy failed');
      } catch (e) { toast('Copy failed'); }
    };
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(showCopied, fallback);
      } else {
        fallback();
      }
    } catch (e) { fallback(); }
  }

  function updateSubmitButton() {
    if (!lastResult) return;
    const p = getProg(lastResult.lessonId);
    const tk = todayKey();
    const count = p.submits[tk] || 0;
    const btn = document.getElementById('submitWaBtn');
    if (!lastResult.isTarget) {
      btn.disabled = true;
      btn.innerHTML = 'Practice only \u2014 nothing to submit';
      return;
    }

    if (count >= MAX_SUBMITS_PER_DAY) {
      btn.disabled = true;
      btn.innerHTML = 'Already submitted twice today';
    } else {
      btn.disabled = false;
      btn.innerHTML = ICONS.send + 'Submit to Teacher · ' + (MAX_SUBMITS_PER_DAY - count) + ' left';
    }
  }

  document.getElementById('submitWaBtn').addEventListener('click', submitToTeacher);

  async function submitToTeacher() {
    if (!lastResult) return;
    const p = getProg(lastResult.lessonId);
    const tk = todayKey();
    const count = p.submits[tk] || 0;
    if (count >= MAX_SUBMITS_PER_DAY) {
      toast('Already submitted twice today');
      return;
    }

    const btn = document.getElementById('submitWaBtn');
    const origHTML = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Preparing image…';

    const r = lastResult;
    const shareText =
      'Decodable Reader Result\n' +
      'Name: ' + profile.name + '\n' +
      'Grade: ' + profile.grade + '\n' +
      'Lesson: ' + r.lessonNumber + ' – ' + r.title + '\n' +
      'Day: ' + r.day + ' of 5\n' +
      'Score: ' + r.score + '/' + r.total + ' (' + r.pct + '%)\n' +
      (typeof r.soundHuntAttempts === 'number'
        ? 'Sound Hunt: Passed on try ' + r.soundHuntAttempts + '\n'
        : '') +
      'Date: ' + formatDate(r.date) + '\n' +
      'Days: ' + FlagsMod.summary(profile.name, r.lessonId) + '\n' +
      (r.counted
        ? 'Counted: Day ' + r.day + ' (new)\n'
        : r.alreadyCounted
          ? 'Day ' + r.day + ' (replay \u2014 already earned)\n'
          : 'Not counted\n') +
      'Submits today: ' + ((p.submits[tk] || 0) + 1) + ' of ' + MAX_SUBMITS_PER_DAY + '\n' +
      (RecMod.has(r.lessonId, r.day) ? 'Reading video: saved on device (teacher can request it)\n' : '') +
      (String(FINISH_CODE || '').replace(/^\s+|\s+$/g, '') ? 'Finish Code: ' + String(FINISH_CODE).replace(/^\s+|\s+$/g, '') + '\n' : '') +
      'Status: ' + (r.passed ? 'Day ' + r.day + ' Completed' : 'Needs practice');

    const waUrl = 'https://wa.me/' + TEACHER_WA + '?text=' + encodeURIComponent(shareText);

    let recorded = false;
    function recordSubmit() {
      if (recorded) return;
      recorded = true;
      p.submits[tk] = (p.submits[tk] || 0) + 1;
      saveStore();
    }
    function openTeacherChat() {
      try { window.open(waUrl, '_blank'); } catch (e) {}
    }

    try {
      if (typeof html2canvas === 'function') {
        const badge = document.getElementById('resultBadge');
        const canvas = await html2canvas(badge, {
          backgroundColor: theme === 'dark' ? '#1e293b' : '#ffffff',
          scale: 2,
          useCORS: true,
          logging: false
        });
        const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
        if (!blob) throw new Error('toBlob returned null');

        const file = new File([blob], 'decodable-result.png', { type: 'image/png' });

        try {
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'decodable-result.png';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 4000);
        } catch (dlErr) {}

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          try {
            await navigator.share({
              files: [file],
              title: 'Decodable Reader Result',
              text: shareText
            });
            recordSubmit();
            toast('Shared. Opening teacher chat…', 2800);
            setTimeout(openTeacherChat, 400);
            return;
          } catch (shareErr) {
            if (shareErr && shareErr.name === 'AbortError') {
              toast('Share cancelled — not submitted', 2600);
              return;
            }
          }
        }

        recordSubmit();
        toast('Opening teacher chat — just tap Send', 3000);
        setTimeout(openTeacherChat, 400);
      } else {
        recordSubmit();
        toast('Opening teacher chat — just tap Send', 2800);
        setTimeout(openTeacherChat, 400);
      }
    } catch (err) {
      console.error(err);
      recordSubmit();
      toast('Opening teacher chat with result text', 2800);
      setTimeout(openTeacherChat, 400);
    } finally {
      setTimeout(updateSubmitButton, 1200);
    }
  }

  function clearLastResult() {
    lastResult = null;
    try { localStorage.removeItem('decodable_lastResult'); } catch (e) {}
  }

  document.getElementById('resHomeBtn').addEventListener('click', () => { clearLastResult(); renderHome(); showScreen('homeScreen'); });
  document.getElementById('resListBtn').addEventListener('click', () => { clearLastResult(); renderHome(); showScreen('homeScreen'); });
  document.getElementById('resAgainBtn').addEventListener('click', () => {
    var keepId = lastResult && lastResult.lessonId;
    clearLastResult();
    if (keepId) openLesson(keepId);
  });

  /* ========== EXPORT / BACKUP / IMPORT ========== */

  function fileName(prefix, ext) {
    const safe = String(profile.name || 'student')
      .replace(/[^a-z0-9]+/gi, '_')
      .replace(/^_+|_+$/g, '')
      .toLowerCase() || 'student';
    const d = new Date();
    const stamp =
      d.getFullYear() +
      String(d.getMonth() + 1).padStart(2, '0') +
      String(d.getDate()).padStart(2, '0');
    return prefix + '_' + safe + '_' + stamp + '.' + ext;
  }

  function downloadBlob(blob, name) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }

  function csvCell(v) {
    if (v === null || v === undefined) return '';
    const s = String(v);
    if (/[",\r\n]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
    return s;
  }

  function exportExcel() {
    if (!profile.name) { toast('No profile to export'); return; }

    var rows = [];
    rows.push([
      'Student', 'Grade', 'Lesson #', 'Title', 'Target Sound',
      'Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Days Done',
      'Best Scores', 'Submits Today', 'Last Played', 'Last Day', 'Champion'
    ]);

    var started = 0, champions = 0;
    var tk = todayKey();

    for (var i = 0; i < LESSONS.length; i++) {
      var l = LESSONS[i];
      var raw = progress[l.id];
      var p = (raw && typeof raw === 'object') ? raw : {};
      var bs = (p.bestScores && typeof p.bestScores === 'object') ? p.bestScores : {};
      var sub = (p.submits && typeof p.submits === 'object') ? p.submits : {};
      var f = FlagsMod.get(profile.name, l.id);
      var n = 0;
      for (var j = 0; j < 5; j++) { if (f[j]) n++; }
      if (n === 5) champions++;
      if (n > 0 || raw) started++;

      var bestKeys = [];
      var k;
      for (k in bs) {
        if (Object.prototype.hasOwnProperty.call(bs, k)) bestKeys.push(k);
      }
      bestKeys.sort(function (a, b) { return Number(a) - Number(b); });
      var bestParts = [];
      for (k = 0; k < bestKeys.length; k++) bestParts.push('D' + bestKeys[k] + ':' + bs[bestKeys[k]]);

      rows.push([
        profile.name, profile.grade, l.lessonNumber, l.title, l.targetSound,
        f[0] ? 'Yes' : 'No', f[1] ? 'Yes' : 'No', f[2] ? 'Yes' : 'No', f[3] ? 'Yes' : 'No', f[4] ? 'Yes' : 'No',
        n, bestParts.join(' '), sub[tk] || 0, p.lastPlayDate || '', p.lastPlayDay || 0,
        n === 5 ? 'Yes' : 'No'
      ]);
    }

    rows.push([]);
    rows.push(['Summary']);
    rows.push(['Lessons with progress', started]);
    rows.push(['Lessons completed all 5 days', champions]);
    rows.push(['Total lessons', LESSONS.length]);
    rows.push(['Target lesson', TARGET_LESSON_TITLE]);
    rows.push(['Target day', targetDay()]);
    rows.push(['Export date', formatDate(new Date())]);

    var lines = [];
    for (var ri = 0; ri < rows.length; ri++) {
      var cells = [];
      for (var ci = 0; ci < rows[ri].length; ci++) cells.push(csvCell(rows[ri][ci]));
      lines.push(cells.join(','));
    }
    var csv = lines.join('\r\n');

    var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' });
    downloadBlob(blob, fileName('progress', 'csv'));
    toast('Exported \u2014 open in Excel', 3000);
  }

  function exportBackup() {
    const data = {
      version: 1,
      exportedAt: new Date().toISOString(),
      flags: FlagsMod.exportAll(),
      profile,
      progress,
      theme,
      ttsSpeed
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    downloadBlob(blob, fileName('backup', 'json'));
    toast('Backup saved', 2600);
  }

  function importBackup() {
    document.getElementById('importFile').click();
  }

  function onImportFile(e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = ev => {
      try {
        const data = JSON.parse(ev.target.result);
        if (!data || typeof data !== 'object') throw new Error('Not an object');
        if (!data.profile || typeof data.profile !== 'object') throw new Error('Missing profile');
        if (!data.progress || typeof data.progress !== 'object' || Array.isArray(data.progress)) {
          throw new Error('Missing or invalid progress');
        }

        const currentName = profile.name || 'this device';
        const incomingName = String(data.profile.name || 'unknown');
        const msg =
          'Import progress for "' + incomingName + '"?\n\n' +
          'This will REPLACE all current progress on this device (' + currentName + ').\n\n' +
          'Continue?';
        if (!window.confirm(msg)) { e.target.value = ''; return; }

        profile = {
          name: String(data.profile.name || '').slice(0, 30),
          grade: String(data.profile.grade || '').slice(0, 10)
        };
        progress = data.progress;
        FlagsMod.importAll(data.flags);
        FlagsMod.ensureStudent(profile.name);
        if (data.theme === 'dark' || data.theme === 'light') theme = data.theme;
        if (data.ttsSpeed === 'slow' || data.ttsSpeed === 'normal') ttsSpeed = data.ttsSpeed;

        saveStore();
        applyTheme();
        updateSpeedBtn();

        if (profile.name && profile.grade) {
          renderHome();
          showScreen('homeScreen');
        } else {
          document.getElementById('profileName').value = profile.name || '';
          document.getElementById('profileGrade').value = profile.grade || '';
          document.getElementById('nameCount').textContent = (profile.name || '').length;
          showScreen('profileScreen');
        }

        toast('Imported ' + Object.keys(progress).length + ' lesson records', 3200);
      } catch (err) {
        console.error(err);
        toast('Import failed — file may be corrupt', 3200);
      } finally {
        e.target.value = '';
      }
    };
    reader.onerror = () => {
      toast('Could not read file', 2600);
      e.target.value = '';
    };
    reader.readAsText(file);
  }

  document.getElementById('exportExcelBtn').addEventListener('click', exportExcel);
  document.getElementById('backupBtn').addEventListener('click', exportBackup);
  document.getElementById('importBtn').addEventListener('click', importBackup);
  document.getElementById('importFile').addEventListener('change', onImportFile);

  /* ========== HELPERS ========== */
  function esc(s) {
    return String(s).replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]);
  }

  /* ========== THEME BUTTONS ========== */
  ['themeBtn', 'themeBtn2', 'themeBtn3', 'themeBtn4', 'themeBtn5'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('click', toggleTheme);
  });

  /* ========== OVERFLOW MENU WIRING ========== */
  (function initOverflowMenu() {
    const btn = document.getElementById('menuBtn');
    const menu = document.getElementById('overflowMenu');
    if (!btn || !menu) return;

    btn.addEventListener('click', e => {
      e.stopPropagation();
      toggleOverflowMenu();
    });

    /* Any click inside the menu closes it. Bubbling ensures the item's own
       handler runs first, then this fires. */
    menu.addEventListener('click', () => {
      closeOverflowMenu();
    });

    document.addEventListener('click', e => {
      if (!menuOpen) return;
      const t = e.target;
      if (menu.contains(t) || btn.contains(t)) return;
      closeOverflowMenu();
    });    document.addEventListener('keydown', e => {
      if (!menuOpen) return;
      if (e.key === 'Escape' || e.keyCode === 27) closeOverflowMenu();
    });
  })();

  /* ========== DATA MENU WIRING (Home) ========== */
  (function initDataMenu() {
    const btn = document.getElementById('dataMenuBtn');
    const menu = document.getElementById('dataMenu');
    if (!btn || !menu) return;
    let open = false;
    function openMenu()  { open = true;  menu.classList.add('open');  btn.setAttribute('aria-expanded','true');  }
    function closeMenu() { open = false; menu.classList.remove('open'); btn.setAttribute('aria-expanded','false'); }
    btn.addEventListener('click', e => { e.stopPropagation(); open ? closeMenu() : openMenu(); });
    menu.addEventListener('click', () => closeMenu());
    document.addEventListener('click', e => {
      if (!open) return;
      const t = e.target;
      if (menu.contains(t) || btn.contains(t)) return;
      closeMenu();
    });
    document.addEventListener('keydown', e => {
      if (!open) return;
      if (e.key === 'Escape' || e.keyCode === 27) closeMenu();
    });
  })();

  /* ========== READING VIDEO (opt-in, saved on device only) ========== */
  var RecMod = (function () {
    var DB_NAME = 'decodable_rec_r2', STORE = 'videos', PREF_KEY = 'decodable_rec_pref_r2';
    var MAX_KEEP = 12, MAX_SEC = 150, MIN_SEC = 3;
    var supported = !!(window.MediaRecorder && window.indexedDB && navigator.mediaDevices &&
                       navigator.mediaDevices.getUserMedia && window.Blob && window.URL);
    var pref = false, db = null, index = {};
    var stream = null, rec = null, chunks = [], timer = null, ctx = null, mime = '';
    var starting = false, stopWanted = false, playUrl = null;

    function el(id) { return document.getElementById(id); }
    function say(m, ms) { try { toast(m, ms); } catch (e) {} }
    function readPref() { try { return window.localStorage.getItem(PREF_KEY) === '1'; } catch (e) { return false; } }
    function writePref(v) { try { window.localStorage.setItem(PREF_KEY, v ? '1' : '0'); } catch (e) {} }

    function openDB(cb) {
      if (db) { cb(db); return; }
      if (!supported) { cb(null); return; }
      var req;
      try { req = window.indexedDB.open(DB_NAME, 1); } catch (e) { cb(null); return; }
      req.onupgradeneeded = function () {
        try { req.result.createObjectStore(STORE, { keyPath: 'id', autoIncrement: true }); } catch (e) {}
      };
      req.onsuccess = function () { db = req.result; cb(db); };
      req.onerror = function () { cb(null); };
    }

    function keyOf(lessonId, day) { return lessonId + '|' + day; }

    function loadIndex() {
      openDB(function (d) {
        if (!d) return;
        index = {};
        try {
          var cur = d.transaction(STORE, 'readonly').objectStore(STORE).openCursor();
          cur.onsuccess = function () {
            var c = cur.result;
            if (c) { index[keyOf(c.value.lessonId, c.value.day)] = true; c['continue'](); }
          };
        } catch (e) {}
      });
    }

    function pickMime() {
      var list = ['video/webm;codecs=vp8,opus', 'video/webm', 'video/mp4'];
      for (var i = 0; i < list.length; i++) {
        try { if (window.MediaRecorder.isTypeSupported(list[i])) return list[i]; } catch (e) {}
      }
      return '';
    }

    function setPill(on) {
      var p = el('recPill');
      if (p) p.style.display = on ? 'block' : 'none';
    }

    function updateUI() {
      var b = el('recToggleBtn');
      if (!b) return;
      if (pref) { b.className = b.className.replace(/\s*active-seg/g, '') + ' active-seg'; }
      else { b.className = b.className.replace(/\s*active-seg/g, ''); }
    }

    function release() {
      if (stream) {
        try { var t = stream.getTracks(); for (var i = 0; i < t.length; i++) t[i].stop(); } catch (e) {}
      }
      stream = null;
    }

    function saveRecord(blob, meta, cb) {
      openDB(function (d) {
        if (!d) { cb(false); return; }
        try {
          var rec2 = { lessonId: meta.lessonId, lessonNumber: meta.lessonNumber, title: meta.title,
                       day: meta.day, student: meta.student, grade: meta.grade, date: meta.date,
                       seconds: meta.seconds, mime: meta.mime, size: blob.size, blob: blob };
          var tx = d.transaction(STORE, 'readwrite');
          var os = tx.objectStore(STORE);
          os.add(rec2);
          tx.oncomplete = function () { index[keyOf(meta.lessonId, meta.day)] = true; prune(); cb(true); };
          tx.onerror = function () { cb(false); };
          tx.onabort = function () { cb(false); };
        } catch (e) { cb(false); }
      });
    }

    function prune() {
      openDB(function (d) {
        if (!d) return;
        try {
          var tx = d.transaction(STORE, 'readwrite');
          var os = tx.objectStore(STORE);
          var keys = [];
          var cur = os.openCursor();
          cur.onsuccess = function () {
            var c = cur.result;
            if (c) { keys.push(c.key); c['continue'](); }
            else {
              while (keys.length > MAX_KEEP) os['delete'](keys.shift());
            }
          };
        } catch (e) {}
      });
    }

    function finalize() {
      var c = ctx; ctx = null;
      var secs = c ? Math.round((new Date().getTime() - c.t0) / 1000) : 0;
      var blob = null;
      try { blob = new window.Blob(chunks, { type: mime || 'video/webm' }); } catch (e) { blob = null; }
      chunks = [];
      rec = null;
      release();
      setPill(false);
      if (!c || !blob || !blob.size) return;
      if (secs < MIN_SEC) { return; }
      c.seconds = secs; c.mime = blob.type || mime;
      saveRecord(blob, c, function (ok) {
        say(ok ? 'Reading video saved on this device' : 'Could not save video', 2600);
      });
    }

    function start() {
      if (!pref || !supported || rec || starting || !currentLesson) return;
      starting = true; stopWanted = false;
      var c = {
        lessonId: currentLesson.id, lessonNumber: currentLesson.lessonNumber, title: currentLesson.title,
        day: currentDay, student: profile.name, grade: profile.grade, date: new Date().getTime(), t0: 0
      };
      var p;
      try {
        p = navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 320 }, height: { ideal: 240 } },
          audio: true
        });
      } catch (e) { starting = false; return; }
      p.then(function (s) {
        starting = false;
        if (stopWanted || !pref) { stream = s; release(); return; }
        stream = s;
        mime = pickMime();
        var opts = { videoBitsPerSecond: 250000, audioBitsPerSecond: 32000 };
        if (mime) opts.mimeType = mime;
        try { rec = new window.MediaRecorder(s, opts); }
        catch (e1) { try { rec = new window.MediaRecorder(s); } catch (e2) { rec = null; } }
        if (!rec) { release(); say('Recording not available here', 2800); return; }
        if (!mime) mime = rec.mimeType || '';
        chunks = [];
        rec.ondataavailable = function (ev) { if (ev.data && ev.data.size) chunks.push(ev.data); };
        rec.onstop = finalize;
        c.t0 = new Date().getTime();
        ctx = c;
        try { rec.start(1000); } catch (e3) { rec = null; ctx = null; release(); return; }
        setPill(true);
        timer = setTimeout(function () { timer = null; stop(); }, MAX_SEC * 1000);
      })['catch'](function () {
        starting = false;
        pref = false; writePref(false); updateUI();
        say('Camera or microphone blocked — recording is off', 3200);
      });
    }

    function stop() {
      stopWanted = true;
      if (timer) { clearTimeout(timer); timer = null; }
      if (rec && rec.state !== 'inactive') { try { rec.stop(); } catch (e) { finalize(); } }
      else if (!starting) { release(); setPill(false); }
    }

    function toggle() {
      if (!supported) { say('Video recording is not supported on this device', 3200); return; }
      if (pref) {
        pref = false; writePref(false); updateUI(); stop();
        say('Recording off', 1800);
        return;
      }
      var ok = true;
      try {
        ok = window.confirm('Record a video of you reading?\n\nThe video is saved only on this device. ' +
          'Your teacher may ask you to send it as proof.');
      } catch (e) { ok = true; }
      if (!ok) return;
      pref = true; writePref(true); updateUI();
      say('Recording on — it starts while you read', 2600);
      start();
    }

    /* ---------- Recordings list ---------- */
    function listAll(cb) {
      openDB(function (d) {
        if (!d) { cb([]); return; }
        var out = [];
        try {
          var cur = d.transaction(STORE, 'readonly').objectStore(STORE).openCursor();
          cur.onsuccess = function () {
            var c = cur.result;
            if (c) { out.push(c.value); c['continue'](); }
            else { out.reverse(); cb(out); }
          };
          cur.onerror = function () { cb([]); };
        } catch (e) { cb([]); }
      });
    }

    function removeOne(id, cb) {
      openDB(function (d) {
        if (!d) { cb(); return; }
        try {
          var tx = d.transaction(STORE, 'readwrite');
          tx.objectStore(STORE)['delete'](id);
          tx.oncomplete = function () { loadIndex(); cb(); };
          tx.onerror = function () { cb(); };
        } catch (e) { cb(); }
      });
    }

    function fmtDate(ts) {
      var d = new Date(ts), m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      var h = d.getHours(), mi = d.getMinutes();
      return d.getDate() + ' ' + m[d.getMonth()] + ' ' + d.getFullYear() + ' · ' + (h < 10 ? '0' : '') + h + ':' + (mi < 10 ? '0' : '') + mi;
    }
    function fmtSize(b) { return b > 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB'; }

    function fileNameFor(r) {
      var ext = /mp4/i.test(r.mime || '') ? 'mp4' : 'webm';
      var who = String(r.student || 'student').replace(/[^a-z0-9]+/gi, '_').replace(/^_+|_+$/g, '').toLowerCase() || 'student';
      return 'reading_' + who + '_L' + r.lessonNumber + '_day' + r.day + '_' + r.id + '.' + ext;
    }

    function download(r) {
      var url = window.URL.createObjectURL(r.blob);
      var a = document.createElement('a');
      a.href = url; a.download = fileNameFor(r);
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(function () { try { window.URL.revokeObjectURL(url); } catch (e) {} }, 4000);
    }

    function sendVideo(r) {
      var text = 'Reading video\nName: ' + r.student + '\nGrade: ' + r.grade + '\nLesson: ' + r.lessonNumber + ' – ' + r.title + '\nDay: ' + r.day + ' of 5';
      try {
        if (typeof window.File === 'function' && navigator.canShare && navigator.share) {
          var f = new window.File([r.blob], fileNameFor(r), { type: r.blob.type || r.mime || 'video/webm' });
          if (navigator.canShare({ files: [f] })) {
            navigator.share({ files: [f], title: 'Reading video', text: text })['catch'](function (e) {
              if (!e || e.name !== 'AbortError') download(r);
            });
            return;
          }
        }
      } catch (e) {}
      download(r);
      say('Video saved to your downloads — send it to your teacher', 3200);
    }

    function stopPlay() {
      if (playUrl) { try { window.URL.revokeObjectURL(playUrl); } catch (e) {} playUrl = null; }
    }

    function esc2(s) { return String(s).replace(/[&<>"']/g, function (m) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]; }); }

    function renderList() {
      var box = el('recList');
      if (!box) return;
      box.innerHTML = '<div class="rec-empty">Loading…</div>';
      listAll(function (items) {
        box.innerHTML = '';
        if (!items.length) {
          box.innerHTML = '<div class="rec-empty">No videos yet. Turn on “Record my reading” in the ⋮ menu while reading.</div>';
          return;
        }
        items.forEach(function (r) {
          var row = document.createElement('div');
          row.className = 'rec-item';
          row.innerHTML =
            '<div class="rec-title">Lesson ' + r.lessonNumber + ' — ' + esc2(r.title) + '</div>' +
            '<div class="rec-meta">Day ' + r.day + ' · ' + fmtDate(r.date) + ' · ' + r.seconds + 's · ' + fmtSize(r.size) + '</div>' +
            '<div class="rec-player"></div>' +
            '<div class="rec-actions">' +
              '<button type="button" class="rec-btn" data-a="play">Play</button>' +
              '<button type="button" class="rec-btn rec-send" data-a="send">Send</button>' +
              '<button type="button" class="rec-btn" data-a="save">Save</button>' +
              '<button type="button" class="rec-btn rec-del" data-a="del">Delete</button>' +
            '</div>';
          row.onclick = function (e) {
            e = e || window.event;
            var t = e.target || e.srcElement;
            var a = t && t.getAttribute ? t.getAttribute('data-a') : null;
            if (!a) return;
            if (a === 'play') {
              stopPlay();
              var all = box.querySelectorAll('.rec-player');
              for (var i = 0; i < all.length; i++) all[i].innerHTML = '';
              playUrl = window.URL.createObjectURL(r.blob);
              var pl = row.querySelector('.rec-player');
              pl.innerHTML = '<video controls playsinline autoplay></video>';
              var v = pl.firstChild;
              v.src = playUrl;
            } else if (a === 'send') { sendVideo(r); }
            else if (a === 'save') { download(r); }
            else if (a === 'del') {
              var ok = true;
              try { ok = window.confirm('Delete this video? This cannot be undone.'); } catch (x) { ok = true; }
              if (ok) { stopPlay(); removeOne(r.id, renderList); }
            }
          };
          box.appendChild(row);
        });
      });
    }

    function openList() {
      if (!supported) { say('Video recording is not supported on this device', 3200); return; }
      el('recOverlay').className = 'rec-overlay show';
      renderList();
    }
    function closeList() {
      stopPlay();
      var pl = document.querySelectorAll('#recList video');
      for (var i = 0; i < pl.length; i++) { try { pl[i].pause(); } catch (e) {} }
      el('recOverlay').className = 'rec-overlay';
    }

    function bind(id, fn) {
      var n = el(id);
      if (n) n.addEventListener('click', fn, false);
    }

    function init() {
      pref = supported && readPref();
      var t = el('recToggleBtn');
      if (t && !supported) t.style.display = 'none';
      var l = el('recListBtn');
      if (l && !supported) l.style.display = 'none';
      updateUI();
      bind('recToggleBtn', toggle);
      bind('recListBtn', openList);
      bind('recCloseBtn', closeList);
      bind('recAskContinue', askContinue);
      bind('recAskStop', askStop);
      bind('recPill', function () { showAsk(!!rec); });
      var ov = el('recOverlay');
      if (ov) ov.addEventListener('click', function (e) { if (e.target === ov) closeList(); }, false);
      document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); }, false);
      loadIndex();
    }

    var lastScreen = '';
    function showAsk(active) {
      var t = el('recAskText');
      if (t) t.innerHTML = active ? 'Your reading is being recorded.<br>Keep going or stop?' : 'Record a video of you reading?<br>It stays on this device.';
      el('recAskOverlay').className = 'rec-ask show';
    }
    function hideAsk() { var o = el('recAskOverlay'); if (o) o.className = 'rec-ask'; }
    function askContinue() {
      hideAsk();
      if (!rec && !starting) start();
    }
    function askStop() {
      hideAsk();
      pref = false; writePref(false); updateUI(); stop();
      say('Recording off', 1800);
    }

    return {
      init: init,
      has: function (lessonId, day) { return !!index[keyOf(lessonId, day)]; },
      onScreen: function (id) {
        var prev = lastScreen; lastScreen = id;
        if (id === 'readingScreen') {
          if (!pref) return;
          if (prev === 'questionsScreen' || prev === 'soundHuntScreen' || prev === 'readingScreen') start();
          else showAsk(false);
        } else { stop(); hideAsk(); }
      },
      ask: function () { showAsk(!!rec); }
    };
  })();
  RecMod.init();

  /* ========== INIT ========== */
  loadStore();
  applyTheme();
  updateSpeedBtn();
  (function initReadButton() {
    const btn = document.getElementById('goQuestionsBtn');
    if (btn) btn.innerHTML = ICONS.lock + 'Finish reading first';
  })();
  (function initSubmitButton() {
    const btn = document.getElementById('submitWaBtn');
    if (btn) btn.innerHTML = ICONS.send + 'Submit to Teacher';
  })();
  (function initShButton() {
    const btn = document.getElementById('shFinishBtn');
    if (btn) btn.innerHTML = ICONS.lock + 'Find all 5 words';
  })();

  (function initRefreshButton() {
    var refreshBtn = document.getElementById('refreshBtn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', function () { location.reload(); });
    }
  })();

  FlagsMod.init(function () {
    var savedLR = null;
    try { savedLR = localStorage.getItem('decodable_lastResult'); } catch (e) {}
    if (savedLR) {
      try {
        lastResult = JSON.parse(savedLR);
        if (lastResult && typeof lastResult.date === 'string') {
          lastResult.date = new Date(lastResult.date);
        }
      } catch (e) { lastResult = null; }
    }

    if (lastResult) {
      renderResults();
      showScreen('resultsScreen');
    } else if (profile.name && profile.grade) {
      FlagsMod.ensureStudent(profile.name);
      renderHome();
      showScreen('homeScreen');
    } else {
      showScreen('profileScreen');
    }
  });
})();
</script>
</body>
</html>